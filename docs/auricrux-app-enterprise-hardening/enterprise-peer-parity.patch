--- a/Auricrux.Shared/Services.cs
+++ b/Auricrux.Shared/Services.cs
@@ -377,6 +377,77 @@ public class AuricruxApiClient
             : null;
     }
 
+    public async Task<IReadOnlyList<(string Title, string Prompt)>> ListStartersAsync(CancellationToken cancellationToken = default)
+    {
+        try
+        {
+            var response = await _httpClient.GetAsync("api/starters", cancellationToken);
+            if (!response.IsSuccessStatusCode)
+            {
+                return Array.Empty<(string, string)>();
+            }
+
+            var payload = await response.Content.ReadFromJsonAsync<JsonElement>(CreateJsonOptions(), cancellationToken);
+            if (!payload.TryGetProperty("starters", out var starters))
+            {
+                return Array.Empty<(string, string)>();
+            }
+
+            return starters.EnumerateArray()
+                .Select(s => (
+                    s.TryGetProperty("title", out var t) ? t.GetString() ?? "" : "",
+                    s.TryGetProperty("prompt", out var p) ? p.GetString() ?? "" : ""))
+                .Where(x => !string.IsNullOrWhiteSpace(x.Item1))
+                .ToList();
+        }
+        catch (Exception ex)
+        {
+            _logger.LogError($"Failed to list starters: {ex.Message}");
+            return Array.Empty<(string, string)>();
+        }
+    }
+
+    public async Task<JsonElement?> UpsertProjectAsync(object project, string? accountEmail = null, CancellationToken cancellationToken = default)
+    {
+        try
+        {
+            using var request = new HttpRequestMessage(HttpMethod.Post, "api/projects")
+            {
+                Content = JsonContent.Create(project, options: CreateJsonOptions())
+            };
+            if (!string.IsNullOrWhiteSpace(accountEmail))
+            {
+                request.Headers.TryAddWithoutValidation("X-Auricrux-Email", accountEmail.Trim());
+            }
+
+            var response = await _httpClient.SendAsync(request, cancellationToken);
+            return response.IsSuccessStatusCode
+                ? await response.Content.ReadFromJsonAsync<JsonElement>(CreateJsonOptions(), cancellationToken)
+                : null;
+        }
+        catch (Exception ex)
+        {
+            _logger.LogError($"Failed to upsert project: {ex.Message}");
+            return null;
+        }
+    }
+
+    public async Task<JsonElement?> CreateShareAsync(object shareRequest, CancellationToken cancellationToken = default)
+    {
+        try
+        {
+            var response = await _httpClient.PostAsJsonAsync("api/share", shareRequest, CreateJsonOptions(), cancellationToken);
+            return response.IsSuccessStatusCode
+                ? await response.Content.ReadFromJsonAsync<JsonElement>(CreateJsonOptions(), cancellationToken)
+                : null;
+        }
+        catch (Exception ex)
+        {
+            _logger.LogError($"Failed to create share: {ex.Message}");
+            return null;
+        }
+    }
+
     private sealed class ModelsPayload
     {
         public List<string>? Models { get; set; }
