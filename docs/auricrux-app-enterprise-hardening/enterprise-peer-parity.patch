+using System.Collections.Concurrent;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+
+namespace Auricrux.Web.Services;
+
+/// <summary>
+/// Shareable conversation link tokens (ChatGPT/Claude share-link parity).
+/// Tokens are opaque; payloads stored as JSON under Data/shares.
+/// </summary>
+public sealed class ShareLinkService
+{
+    private readonly string _dir;
+    private readonly ConcurrentDictionary<string, ShareRecord> _cache = new(StringComparer.Ordinal);
+
+    public ShareLinkService(IHostEnvironment env)
+    {
+        _dir = Path.Combine(env.ContentRootPath, "Data", "shares");
+        Directory.CreateDirectory(_dir);
+    }
+
+    public ShareRecord Create(string sessionId, string title, IEnumerable<ShareMessage> messages, TimeSpan? ttl = null)
+    {
+        var token = Convert.ToHexString(RandomNumberGenerator.GetBytes(16)).ToLowerInvariant();
+        var record = new ShareRecord
+        {
+            Token = token,
+            SessionId = sessionId,
+            Title = string.IsNullOrWhiteSpace(title) ? "Auricrux conversation" : title.Trim(),
+            CreatedAtUtc = DateTime.UtcNow,
+            ExpiresAtUtc = DateTime.UtcNow.Add(ttl ?? TimeSpan.FromDays(7)),
+            Messages = messages.Take(200).ToList()
+        };
+
+        var path = Path.Combine(_dir, token + ".json");
+        File.WriteAllText(path, JsonSerializer.Serialize(record, new JsonSerializerOptions { WriteIndented = true }));
+        _cache[token] = record;
+        return record;
+    }
+
+    public ShareRecord? Get(string token)
+    {
+        if (string.IsNullOrWhiteSpace(token))
+        {
+            return null;
+        }
+
+        token = token.Trim();
+        if (_cache.TryGetValue(token, out var cached))
+        {
+            return cached.ExpiresAtUtc < DateTime.UtcNow ? null : cached;
+        }
+
+        var path = Path.Combine(_dir, token + ".json");
+        if (!File.Exists(path))
+        {
+            return null;
+        }
+
+        var record = JsonSerializer.Deserialize<ShareRecord>(File.ReadAllText(path), new JsonSerializerOptions
+        {
+            PropertyNameCaseInsensitive = true
+        });
+        if (record is null || record.ExpiresAtUtc < DateTime.UtcNow)
+        {
+            return null;
+        }
+
+        _cache[token] = record;
+        return record;
+    }
+}
+
+public sealed class ShareRecord
+{
+    public string Token { get; set; } = string.Empty;
+    public string SessionId { get; set; } = string.Empty;
+    public string Title { get; set; } = string.Empty;
+    public DateTime CreatedAtUtc { get; set; }
+    public DateTime ExpiresAtUtc { get; set; }
+    public List<ShareMessage> Messages { get; set; } = [];
+}
+
+public sealed class ShareMessage
+{
+    public string Role { get; set; } = string.Empty;
+    public string Content { get; set; } = string.Empty;
+    public DateTime Timestamp { get; set; } = DateTime.UtcNow;
+}
+
+public sealed class CreateShareRequest
+{
+    public string SessionId { get; set; } = Guid.NewGuid().ToString();
+    public string? Title { get; set; }
+    public List<ShareMessage> Messages { get; set; } = [];
+    public int? TtlHours { get; set; }
+}
