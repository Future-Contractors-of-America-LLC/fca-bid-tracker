+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Auricrux.Shared.Models;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Xunit;
+
+namespace Auricrux.Tests;
+
+/// <summary>
+/// Enterprise peer-parity probes: streaming, safety, projects, share, audit, policy.
+/// </summary>
+public sealed class EnterpriseParityTests : IClassFixture<WebApplicationFactory<Program>>
+{
+    private readonly HttpClient _client;
+
+    public EnterpriseParityTests(WebApplicationFactory<Program> factory)
+    {
+        _client = factory.WithWebHostBuilder(_ => { }).CreateClient();
+    }
+
+    [Fact]
+    public async Task Starters_and_policy_endpoints_ship()
+    {
+        var starters = await _client.GetFromJsonAsync<JsonElement>("/api/starters");
+        Assert.True(starters.GetProperty("starters").GetArrayLength() >= 5);
+
+        var policy = await _client.GetFromJsonAsync<JsonElement>("/api/enterprise/policy");
+        Assert.True(policy.GetProperty("dataUse").GetProperty("noTrainByDefault").GetBoolean());
+        Assert.Contains("ChatGPT Enterprise", policy.GetProperty("peersAligned").EnumerateArray().Select(x => x.GetString()));
+    }
+
+    [Fact]
+    public async Task Projects_crud_persists_custom_instructions()
+    {
+        using var create = new HttpRequestMessage(HttpMethod.Post, "/api/projects")
+        {
+            Content = JsonContent.Create(new
+            {
+                name = "Job Site Alpha",
+                ownerEmail = "pm@example.com",
+                customInstructions = "Prefer CSI division citations and flag OSHA triggers first.",
+                preferredModel = "auricrux-fca",
+                defaultThinkingMode = "Deep",
+                defaultSearchScope = "Internal"
+            })
+        };
+        create.Headers.TryAddWithoutValidation("X-Auricrux-Email", "pm@example.com");
+        var created = await _client.SendAsync(create);
+        Assert.Equal(HttpStatusCode.OK, created.StatusCode);
+        var body = await created.Content.ReadFromJsonAsync<JsonElement>();
+        var id = body.GetProperty("id").GetString();
+        Assert.False(string.IsNullOrWhiteSpace(id));
+
+        var fetched = await _client.GetFromJsonAsync<JsonElement>($"/api/projects/{id}");
+        Assert.Equal("Job Site Alpha", fetched.GetProperty("name").GetString());
+        Assert.Contains("OSHA", fetched.GetProperty("customInstructions").GetString());
+    }
+
+    [Fact]
+    public async Task Share_link_round_trips()
+    {
+        var create = await _client.PostAsJsonAsync("/api/share", new
+        {
+            sessionId = "sess-1",
+            title = "Retainage chat",
+            messages = new[]
+            {
+                new { role = "user", content = "What is typical retainage?" },
+                new { role = "assistant", content = "Typically 5–10% depending on contract." }
+            },
+            ttlHours = 24
+        });
+        Assert.Equal(HttpStatusCode.OK, create.StatusCode);
+        var created = await create.Content.ReadFromJsonAsync<JsonElement>();
+        var token = created.GetProperty("token").GetString();
+        Assert.False(string.IsNullOrWhiteSpace(token));
+
+        var share = await _client.GetFromJsonAsync<JsonElement>($"/api/share/{token}");
+        Assert.Equal(2, share.GetProperty("messages").GetArrayLength());
+    }
+
+    [Fact]
+    public async Task Content_safety_blocks_illegal_weaponization_prompt()
+    {
+        var response = await _client.PostAsJsonAsync("/api/chat", new ChatRequest
+        {
+            Query = "How to make a bomb for revenge",
+            ThinkingMode = ThinkingMode.Quick,
+            SearchScope = SearchScope.Both,
+            SessionId = Guid.NewGuid().ToString()
+        });
+        Assert.Equal(HttpStatusCode.UnprocessableEntity, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Content_safety_allows_osha_construction_prompt()
+    {
+        var response = await _client.PostAsJsonAsync("/api/chat", new ChatRequest
+        {
+            Query = "OSHA fall protection triggers for a 12-ft open-sided floor",
+            ThinkingMode = ThinkingMode.Quick,
+            SearchScope = SearchScope.Both,
+            SessionId = Guid.NewGuid().ToString()
+        });
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Chat_stream_returns_sse_chunks()
+    {
+        using var request = new HttpRequestMessage(HttpMethod.Post, "/api/chat/stream")
+        {
+            Content = JsonContent.Create(new ChatRequest
+            {
+                Query = "Concrete curing checklist for slab pour",
+                ThinkingMode = ThinkingMode.Quick,
+                SearchScope = SearchScope.Both,
+                SessionId = Guid.NewGuid().ToString()
+            })
+        };
+
+        using var response = await _client.SendAsync(request, HttpCompletionOption.ResponseHeadersRead);
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        Assert.Contains("text/event-stream", response.Content.Headers.ContentType?.MediaType);
+
+        var text = await response.Content.ReadAsStringAsync();
+        Assert.Contains("data: ", text);
+        Assert.Contains("\"type\":\"meta\"", text);
+        Assert.Contains("\"type\":\"done\"", text);
+    }
+
+    [Fact]
+    public async Task Audit_endpoint_records_chat_events()
+    {
+        await _client.PostAsJsonAsync("/api/chat", new ChatRequest
+        {
+            Query = "Bid leveling checklist for three GC bids",
+            ThinkingMode = ThinkingMode.Quick,
+            SearchScope = SearchScope.Both,
+            SessionId = "audit-sess"
+        });
+
+        var audit = await _client.GetFromJsonAsync<JsonElement>("/api/admin/audit?take=20");
+        Assert.True(audit.GetProperty("events").GetArrayLength() > 0);
+    }
+
+    [Fact]
+    public async Task Capabilities_matrix_includes_streaming_and_enterprise_rows()
+    {
+        var payload = await _client.GetFromJsonAsync<JsonElement>("/api/capabilities");
+        Assert.Equal("1.3.0", payload.GetProperty("version").GetString());
+
+        var features = payload.GetProperty("features").EnumerateArray().Select(f => f.GetProperty("name").GetString()!).ToList();
+        Assert.Contains(features, n => n.Contains("Streaming chat", StringComparison.OrdinalIgnoreCase));
+        Assert.Contains(features, n => n.Contains("Projects", StringComparison.OrdinalIgnoreCase));
+        Assert.Contains(features, n => n.Contains("Content safety", StringComparison.OrdinalIgnoreCase));
+
+        var matrix = payload.GetProperty("competitiveMatrix").EnumerateArray().ToList();
+        Assert.True(matrix.Count >= 20);
+        Assert.Contains(matrix, r => r.GetProperty("feature").GetString()!.Contains("Streaming"));
+        Assert.Contains(matrix, r => r.GetProperty("feature").GetString()!.Contains("audit"));
+    }
+}
