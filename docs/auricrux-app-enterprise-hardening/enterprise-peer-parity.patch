+using System.Collections.Concurrent;
+using System.Text.Json;
+
+namespace Auricrux.Web.Services;
+
+/// <summary>
+/// Claude Projects / Custom GPT parity: named workspaces with custom instructions,
+/// preferred model, and sticky search/thinking defaults.
+/// </summary>
+public sealed class ProjectWorkspaceService
+{
+    private readonly string _path;
+    private readonly ConcurrentDictionary<string, ProjectWorkspace> _projects = new(StringComparer.OrdinalIgnoreCase);
+    private readonly object _gate = new();
+
+    public ProjectWorkspaceService(IHostEnvironment env)
+    {
+        var dir = Path.Combine(env.ContentRootPath, "Data", "projects");
+        Directory.CreateDirectory(dir);
+        _path = Path.Combine(dir, "projects.json");
+        Load();
+    }
+
+    public IReadOnlyList<ProjectWorkspace> List(string? ownerEmail = null)
+    {
+        var all = _projects.Values.OrderByDescending(p => p.UpdatedAtUtc).ToList();
+        if (string.IsNullOrWhiteSpace(ownerEmail))
+        {
+            return all;
+        }
+
+        return all.Where(p => p.OwnerEmail.Equals(ownerEmail.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
+    }
+
+    public ProjectWorkspace? Get(string projectId) =>
+        _projects.TryGetValue(projectId, out var p) ? p : null;
+
+    public ProjectWorkspace Upsert(ProjectWorkspace input)
+    {
+        if (string.IsNullOrWhiteSpace(input.Name))
+        {
+            throw new ArgumentException("Project name is required.");
+        }
+
+        var id = string.IsNullOrWhiteSpace(input.Id) ? Guid.NewGuid().ToString("N") : input.Id.Trim();
+        var existing = Get(id);
+        var project = new ProjectWorkspace
+        {
+            Id = id,
+            Name = input.Name.Trim(),
+            OwnerEmail = (input.OwnerEmail ?? existing?.OwnerEmail ?? "anonymous").Trim(),
+            CustomInstructions = input.CustomInstructions?.Trim() ?? existing?.CustomInstructions ?? string.Empty,
+            PreferredModel = string.IsNullOrWhiteSpace(input.PreferredModel)
+                ? existing?.PreferredModel
+                : input.PreferredModel.Trim(),
+            DefaultThinkingMode = input.DefaultThinkingMode ?? existing?.DefaultThinkingMode ?? "Auto",
+            DefaultSearchScope = input.DefaultSearchScope ?? existing?.DefaultSearchScope ?? "Both",
+            CreatedAtUtc = existing?.CreatedAtUtc ?? DateTime.UtcNow,
+            UpdatedAtUtc = DateTime.UtcNow
+        };
+
+        _projects[id] = project;
+        Persist();
+        return project;
+    }
+
+    public bool Delete(string projectId)
+    {
+        var removed = _projects.TryRemove(projectId, out _);
+        if (removed)
+        {
+            Persist();
+        }
+
+        return removed;
+    }
+
+    public IReadOnlyList<PromptStarter> DefaultStarters() =>
+    [
+        new("RFI draft", "Draft an RFI for a drawing conflict between architectural and structural plans. Include drawing refs and a proposed solution."),
+        new("OSHA fall protection", "What OSHA 1926 fall-protection triggers apply for a 12-ft open-sided floor with leading-edge steel work?"),
+        new("Concrete pour checklist", "Give a field checklist for a mid-rise slab pour: pre-pour, during, and post-pour curing."),
+        new("Pay app SOV", "Explain how to align a Schedule of Values with an AIA G702/G703 style pay application for a $2.4M TI."),
+        new("Bid leveling", "Build a bid-leveling matrix for three GC bids with different allowances, alternates, and unit prices."),
+        new("Change order narrative", "Write a professional change-order narrative for owner-directed scope added after drywall hang.")
+    ];
+
+    private void Load()
+    {
+        if (!File.Exists(_path))
+        {
+            return;
+        }
+
+        try
+        {
+            var json = File.ReadAllText(_path);
+            var items = JsonSerializer.Deserialize<List<ProjectWorkspace>>(json, new JsonSerializerOptions
+            {
+                PropertyNameCaseInsensitive = true
+            }) ?? [];
+            foreach (var item in items)
+            {
+                if (!string.IsNullOrWhiteSpace(item.Id))
+                {
+                    _projects[item.Id] = item;
+                }
+            }
+        }
+        catch
+        {
+            // Corrupt file should not take down the host; start empty and rewrite on next upsert.
+        }
+    }
+
+    private void Persist()
+    {
+        lock (_gate)
+        {
+            var json = JsonSerializer.Serialize(_projects.Values.OrderBy(p => p.Name), new JsonSerializerOptions
+            {
+                WriteIndented = true
+            });
+            File.WriteAllText(_path, json);
+        }
+    }
+}
+
+public sealed class ProjectWorkspace
+{
+    public string Id { get; set; } = string.Empty;
+    public string Name { get; set; } = string.Empty;
+    public string OwnerEmail { get; set; } = "anonymous";
+    public string CustomInstructions { get; set; } = string.Empty;
+    public string? PreferredModel { get; set; }
+    public string? DefaultThinkingMode { get; set; }
+    public string? DefaultSearchScope { get; set; }
+    public DateTime CreatedAtUtc { get; set; } = DateTime.UtcNow;
+    public DateTime UpdatedAtUtc { get; set; } = DateTime.UtcNow;
+}
+
+public sealed record PromptStarter(string Title, string Prompt);
