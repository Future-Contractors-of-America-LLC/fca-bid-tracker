@@ -0,0 +1,66 @@
+using System.Collections.Concurrent;
+using System.Text.Json;
+
+namespace Auricrux.Web.Services;
+
+/// <summary>
+/// Append-only enterprise audit trail for chat/agent/admin actions (SOC2 / procurement posture).
+/// Persists JSONL under Data/audit and keeps a bounded in-memory ring for /api/admin/audit.
+/// </summary>
+public sealed class AuditLogService
+{
+    private readonly string _path;
+    private readonly ConcurrentQueue<AuditEvent> _ring = new();
+    private readonly object _gate = new();
+    private const int RingCapacity = 500;
+
+    public AuditLogService(IHostEnvironment env)
+    {
+        var dir = Path.Combine(env.ContentRootPath, "Data", "audit");
+        Directory.CreateDirectory(dir);
+        _path = Path.Combine(dir, "audit.jsonl");
+    }
+
+    public void Record(string action, string? actor = null, string? sessionId = null, object? detail = null, string outcome = "ok")
+    {
+        var evt = new AuditEvent
+        {
+            Id = Guid.NewGuid().ToString("N"),
+            AtUtc = DateTime.UtcNow,
+            Action = action,
+            Actor = string.IsNullOrWhiteSpace(actor) ? "anonymous" : actor.Trim(),
+            SessionId = sessionId,
+            Outcome = outcome,
+            Detail = detail
+        };
+
+        lock (_gate)
+        {
+            File.AppendAllText(_path, JsonSerializer.Serialize(evt) + Environment.NewLine);
+        }
+
+        _ring.Enqueue(evt);
+        while (_ring.Count > RingCapacity && _ring.TryDequeue(out _))
+        {
+        }
+    }
+
+    public IReadOnlyList<AuditEvent> Recent(int take = 50)
+    {
+        take = Math.Clamp(take, 1, RingCapacity);
+        return _ring.Reverse().Take(take).ToList();
+    }
+
+    public string LogPath => _path;
+}
+
+public sealed class AuditEvent
+{
+    public string Id { get; set; } = string.Empty;
+    public DateTime AtUtc { get; set; }
+    public string Action { get; set; } = string.Empty;
+    public string Actor { get; set; } = string.Empty;
+    public string? SessionId { get; set; }
+    public string Outcome { get; set; } = "ok";
+    public object? Detail { get; set; }
+}
