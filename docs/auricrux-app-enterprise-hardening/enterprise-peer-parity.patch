+using Auricrux.Shared.Models;
+using Auricrux.Web.Services;
+using Microsoft.AspNetCore.Mvc;
+
+namespace Auricrux.Web.Controllers;
+
+/// <summary>
+/// Enterprise surfaces that match Copilot/Claude/Gemini procurement expectations:
+/// projects, prompt starters, share links, audit trail, and AI data-use policy.
+/// </summary>
+[ApiController]
+[Route("api")]
+public sealed class EnterpriseController(
+    ProjectWorkspaceService projects,
+    ShareLinkService shares,
+    AuditLogService audit,
+    IConfiguration config) : ControllerBase
+{
+    [HttpGet("starters")]
+    public ActionResult<object> ListStarters() => Ok(new { starters = projects.DefaultStarters() });
+
+    [HttpGet("projects")]
+    public ActionResult<object> ListProjects([FromHeader(Name = "X-Auricrux-Email")] string? email) =>
+        Ok(new { projects = projects.List(email) });
+
+    [HttpGet("projects/{id}")]
+    public ActionResult<ProjectWorkspace> GetProject(string id)
+    {
+        var project = projects.Get(id);
+        return project is null ? NotFound() : Ok(project);
+    }
+
+    [HttpPost("projects")]
+    public ActionResult<ProjectWorkspace> UpsertProject(
+        [FromBody] ProjectWorkspace body,
+        [FromHeader(Name = "X-Auricrux-Email")] string? email)
+    {
+        if (string.IsNullOrWhiteSpace(body.OwnerEmail) && !string.IsNullOrWhiteSpace(email))
+        {
+            body.OwnerEmail = email.Trim();
+        }
+
+        try
+        {
+            var saved = projects.Upsert(body);
+            audit.Record("project.upsert", body.OwnerEmail, detail: new { saved.Id, saved.Name });
+            return Ok(saved);
+        }
+        catch (ArgumentException ex)
+        {
+            return BadRequest(new { error = ex.Message });
+        }
+    }
+
+    [HttpDelete("projects/{id}")]
+    public IActionResult DeleteProject(string id)
+    {
+        if (!projects.Delete(id))
+        {
+            return NotFound();
+        }
+
+        audit.Record("project.delete", detail: new { id });
+        return NoContent();
+    }
+
+    [HttpPost("share")]
+    public ActionResult<object> CreateShare([FromBody] CreateShareRequest request)
+    {
+        if (request.Messages.Count == 0)
+        {
+            return BadRequest(new { error = "At least one message is required." });
+        }
+
+        var ttl = request.TtlHours is > 0 and <= 24 * 30
+            ? TimeSpan.FromHours(request.TtlHours.Value)
+            : TimeSpan.FromDays(7);
+        var record = shares.Create(request.SessionId, request.Title ?? "Auricrux conversation", request.Messages, ttl);
+        audit.Record("share.create", sessionId: request.SessionId, detail: new { record.Token, expires = record.ExpiresAtUtc });
+        return Ok(new
+        {
+            token = record.Token,
+            path = $"/api/share/{record.Token}",
+            expiresAtUtc = record.ExpiresAtUtc
+        });
+    }
+
+    [HttpGet("share/{token}")]
+    public ActionResult<ShareRecord> GetShare(string token)
+    {
+        var record = shares.Get(token);
+        return record is null ? NotFound() : Ok(record);
+    }
+
+    [HttpGet("admin/audit")]
+    public ActionResult<object> GetAudit([FromQuery] int take = 50)
+    {
+        return Ok(new
+        {
+            path = audit.LogPath,
+            events = audit.Recent(take)
+        });
+    }
+
+    [HttpGet("enterprise/policy")]
+    public ActionResult<object> GetEnterprisePolicy()
+    {
+        var noTrainDefault = config.GetValue("Enterprise:NoTrainByDefault", true);
+        var retentionDays = config.GetValue("Enterprise:ConversationRetentionDays", 90);
+        return Ok(new
+        {
+            product = "Auricrux",
+            peersAligned = new[] { "ChatGPT Enterprise", "Claude for Enterprise", "Gemini for Workspace", "Microsoft Copilot", "Grok (xAI)" },
+            dataUse = new
+            {
+                trainingOnCustomerContent = "off-by-default",
+                noTrainByDefault = noTrainDefault,
+                customerCanOptIn = true,
+                retentionDays,
+                auditTrail = true,
+                contentSafety = true,
+                notes = "Enterprise default matches major-player procurement: no training on customer prompts/responses unless explicitly opted in."
+            },
+            security = new
+            {
+                oauthOidc = true,
+                rateLimiting = true,
+                securityHeaders = true,
+                correlationIds = true,
+                sseStreaming = true
+            },
+            version = "1.3.0"
+        });
+    }
+}
