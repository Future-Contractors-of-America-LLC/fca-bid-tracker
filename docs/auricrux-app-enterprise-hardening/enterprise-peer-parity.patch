+using System.Text.RegularExpressions;
+
+namespace Auricrux.Web.Services;
+
+/// <summary>
+/// Enterprise content-safety gate (ChatGPT/Claude/Gemini-class moderation posture).
+/// Blocks clearly abusive / illegal weaponization prompts while allowing legitimate
+/// construction safety, demolition, and hazardous-materials professional discussion.
+/// </summary>
+public sealed class ContentSafetyService(ILogger<ContentSafetyService> logger)
+{
+    private static readonly Regex[] BlockPatterns =
+    [
+        new(@"\bhow\s+to\s+(make|build|synthesize)\s+(a\s+)?(bomb|explosive|ricin|fentanyl)\b", RegexOptions.IgnoreCase | RegexOptions.Compiled),
+        new(@"\b(child\s*porn|csam|sexual\s+content\s+(involving|with)\s+(a\s+)?minor)\b", RegexOptions.IgnoreCase | RegexOptions.Compiled),
+        new(@"\b(credit\s*card\s*(dump|skimmer)|ransomware\s+as\s+a\s+service)\b", RegexOptions.IgnoreCase | RegexOptions.Compiled)
+    ];
+
+    private static readonly string[] WarnHints =
+    [
+        "ignore previous instructions",
+        "jailbreak",
+        "dan mode",
+        "bypass safety"
+    ];
+
+    public ContentSafetyResult Evaluate(string? text, string surface = "chat")
+    {
+        if (string.IsNullOrWhiteSpace(text))
+        {
+            return ContentSafetyResult.Allow();
+        }
+
+        foreach (var pattern in BlockPatterns)
+        {
+            if (pattern.IsMatch(text))
+            {
+                logger.LogWarning("Content safety block on {Surface}: pattern={Pattern}", surface, pattern);
+                return ContentSafetyResult.Block(
+                    "Request blocked by Auricrux content safety policy. Professional construction, safety, and compliance questions are allowed; illegal weaponization and CSAM are not.");
+            }
+        }
+
+        var lowered = text.ToLowerInvariant();
+        var warnings = WarnHints.Where(h => lowered.Contains(h)).ToArray();
+        if (warnings.Length > 0)
+        {
+            return ContentSafetyResult.Allow(warnings);
+        }
+
+        return ContentSafetyResult.Allow();
+    }
+}
+
+public sealed class ContentSafetyResult
+{
+    public bool Allowed { get; init; }
+    public string? BlockReason { get; init; }
+    public IReadOnlyList<string> Warnings { get; init; } = [];
+
+    public static ContentSafetyResult Allow(params string[] warnings) =>
+        new() { Allowed = true, Warnings = warnings };
+
+    public static ContentSafetyResult Block(string reason) =>
+        new() { Allowed = false, BlockReason = reason };
+}
