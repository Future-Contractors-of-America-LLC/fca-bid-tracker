@@ -0,0 +1,58 @@
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.AspNetCore.Mvc.Filters;
+
+namespace Auricrux.Web.Security;
+
+/// <summary>
+/// Marks an endpoint as reachable without an identity even when authentication is enabled —
+/// uptime probes, capability discovery, and the sign-up path that necessarily precedes having
+/// an account. Everything not carrying this attribute is default-deny once <c>Auth:Enabled</c>
+/// is true.
+/// </summary>
+[AttributeUsage(AttributeTargets.Class | AttributeTargets.Method, AllowMultiple = false)]
+public sealed class AuricruxPublicAttribute : Attribute;
+
+/// <summary>
+/// Default-deny gate applied to every API endpoint.
+///
+/// This is a global filter rather than per-action <c>[Authorize]</c> for two reasons: endpoints
+/// stay reachable in hosts that register no authentication scheme at all (rather than failing
+/// with "No authenticationScheme was specified"), and the decision reads live configuration, so
+/// configuration layered on after the host is built — as the integration tests do — is honoured.
+/// </summary>
+public sealed class AuricruxAuthorizationFilter(
+    AuricruxPrincipalResolver resolver,
+    ILogger<AuricruxAuthorizationFilter> logger) : IAuthorizationFilter
+{
+    /// <inheritdoc />
+    public void OnAuthorization(AuthorizationFilterContext context)
+    {
+        if (context.ActionDescriptor.EndpointMetadata.OfType<AuricruxPublicAttribute>().Any())
+        {
+            return;
+        }
+
+        if (!resolver.AuthEnabled)
+        {
+            return;
+        }
+
+        var principal = resolver.Resolve(context.HttpContext);
+        if (principal.IsAuthenticated)
+        {
+            return;
+        }
+
+        logger.LogWarning(
+            "Denied unauthenticated {Method} {Path} (correlation={CorrelationId})",
+            context.HttpContext.Request.Method,
+            context.HttpContext.Request.Path,
+            context.HttpContext.TraceIdentifier);
+
+        context.Result = new UnauthorizedObjectResult(new
+        {
+            error = "Authentication required.",
+            correlationId = context.HttpContext.TraceIdentifier
+        });
+    }
+}
diff --git a/Auricrux.Web/Security/AuricruxPrincipal.cs b/Auricrux.Web/Security/AuricruxPrincipal.cs
new file mode 100644
index 0000000..666ecd0
--- /dev/null
+++ b/Auricrux.Web/Security/AuricruxPrincipal.cs
@@ -0,0 +1,131 @@
+using System.Security.Claims;
+using System.Security.Cryptography;
+using System.Text;
+
+namespace Auricrux.Web.Security;
+
+/// <summary>
+/// How the caller's identity was established for the current request.
+/// </summary>
+public enum PrincipalSource
+{
+    /// <summary>No identity could be established.</summary>
+    Anonymous = 0,
+
+    /// <summary>Identity asserted by an unverified client header (only honoured when authentication is disabled).</summary>
+    ClientAsserted = 1,
+
+    /// <summary>Identity taken from a validated OIDC/JWT security token.</summary>
+    Authenticated = 2
+}
+
+/// <summary>
+/// The resolved caller for a request: who they are, how strongly that is known, and the
+/// tenant partition their stored data belongs to.
+/// </summary>
+/// <param name="Subject">Stable caller identifier — email when known, otherwise the token subject.</param>
+/// <param name="Source">How <paramref name="Subject"/> was established.</param>
+/// <param name="IsAdmin">Whether the caller is on the configured administrator allow-list.</param>
+public sealed record AuricruxPrincipal(string? Subject, PrincipalSource Source, bool IsAdmin)
+{
+    /// <summary>The caller for a request with no established identity.</summary>
+    public static readonly AuricruxPrincipal Anonymous = new(null, PrincipalSource.Anonymous, false);
+
+    /// <summary>Whether the caller's identity was proven by a validated security token.</summary>
+    public bool IsAuthenticated => Source == PrincipalSource.Authenticated;
+
+    /// <summary>Whether any identity — verified or client-asserted — is attached to the request.</summary>
+    public bool HasIdentity => !string.IsNullOrWhiteSpace(Subject);
+
+    /// <summary>
+    /// Filesystem- and key-safe partition for this caller's stored data. Anonymous callers share
+    /// the single "anonymous" partition, which is why unauthenticated deployments must be treated
+    /// as single-tenant.
+    /// </summary>
+    public string TenantKey => string.IsNullOrWhiteSpace(Subject)
+        ? "anonymous"
+        : Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(Subject))).ToLowerInvariant()[..32];
+
+    /// <summary>Whether this caller owns <paramref name="email"/>, or may act on any account.</summary>
+    public bool Owns(string? email) =>
+        IsAdmin || (HasIdentity
+                    && !string.IsNullOrWhiteSpace(email)
+                    && string.Equals(Subject, email.Trim(), StringComparison.OrdinalIgnoreCase));
+}
+
+/// <summary>
+/// Resolves the caller for a request.
+///
+/// The controlling rule is that a client-supplied identity header is only trusted when
+/// authentication is switched off. Once <c>Auth:Enabled</c> is true the header is ignored
+/// outright, so a caller cannot present someone else's email to inherit their plan, quota, or
+/// stored data — identity then comes only from a validated token.
+/// </summary>
+public sealed class AuricruxPrincipalResolver(IConfiguration config)
+{
+    /// <summary>Header carrying a client-asserted account email in unauthenticated deployments.</summary>
+    public const string EmailHeader = "X-Auricrux-Email";
+
+    /// <summary>Whether token authentication is switched on and usable.</summary>
+    public bool AuthEnabled =>
+        config.GetValue("Auth:Enabled", false)
+        && !string.IsNullOrWhiteSpace(config["Auth:Authority"]);
+
+    /// <summary>Resolves the caller for <paramref name="context"/>.</summary>
+    public AuricruxPrincipal Resolve(HttpContext context)
+    {
+        var authEnabled = AuthEnabled;
+        var user = context.User;
+
+        if (user.Identity?.IsAuthenticated == true)
+        {
+            var subject = FirstClaim(user, ClaimTypes.Email, "email", "preferred_username", ClaimTypes.Upn)
+                          ?? FirstClaim(user, ClaimTypes.NameIdentifier, "sub")
+                          ?? user.Identity.Name;
+            var normalized = Normalize(subject);
+            return new AuricruxPrincipal(normalized, PrincipalSource.Authenticated, IsAdminEmail(normalized));
+        }
+
+        // Default-deny: with authentication on, an unverified header must never establish identity.
+        if (authEnabled)
+        {
+            return AuricruxPrincipal.Anonymous;
+        }
+
+        var asserted = Normalize(context.Request.Headers[EmailHeader].ToString());
+        return asserted is null
+            ? AuricruxPrincipal.Anonymous
+            : new AuricruxPrincipal(asserted, PrincipalSource.ClientAsserted, IsAdminEmail(asserted));
+    }
+
+    private bool IsAdminEmail(string? email)
+    {
+        if (string.IsNullOrWhiteSpace(email))
+        {
+            return false;
+        }
+
+        var admins = config.GetSection("Auth:AdminEmails").Get<string[]>() ?? [];
+        return admins.Any(a => string.Equals(a?.Trim(), email, StringComparison.OrdinalIgnoreCase));
+    }
+
+    private static string? FirstClaim(ClaimsPrincipal user, params string[] claimTypes)
+    {
+        foreach (var type in claimTypes)
+        {
+            var value = user.FindFirst(type)?.Value;
+            if (!string.IsNullOrWhiteSpace(value))
+            {
+                return value;
+            }
+        }
+
+        return null;
+    }
+
+    private static string? Normalize(string? value)
+    {
+        var trimmed = value?.Trim();
+        return string.IsNullOrEmpty(trimmed) ? null : trimmed.ToLowerInvariant();
+    }
+}
diff --git a/Auricrux.Web/Security/HttpContextPrincipalExtensions.cs b/Auricrux.Web/Security/HttpContextPrincipalExtensions.cs
new file mode 100644
index 0000000..2b0bf93
--- /dev/null
+++ b/Auricrux.Web/Security/HttpContextPrincipalExtensions.cs
@@ -0,0 +1,27 @@
+namespace Auricrux.Web.Security;
+
+/// <summary>
+/// Access to the resolved Auricrux caller from anywhere in the request pipeline.
+/// </summary>
+public static class HttpContextPrincipalExtensions
+{
+    private const string ItemKey = "auricrux.principal";
+
+    /// <summary>
+    /// Returns the caller for this request, resolving and caching it on first use so repeated
+    /// lookups within a request stay consistent.
+    /// </summary>
+    public static AuricruxPrincipal GetAuricruxPrincipal(this HttpContext context)
+    {
+        if (context.Items.TryGetValue(ItemKey, out var cached) && cached is AuricruxPrincipal principal)
+        {
+            return principal;
+        }
+
+        var resolved = context.RequestServices
+            .GetRequiredService<AuricruxPrincipalResolver>()
+            .Resolve(context);
+        context.Items[ItemKey] = resolved;
+        return resolved;
+    }
+}
