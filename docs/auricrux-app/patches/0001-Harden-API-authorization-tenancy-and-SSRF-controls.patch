new file mode 100644
index 0000000..c4cf6e7
--- /dev/null
+++ b/Auricrux.Web/Security/OutboundUrlGuard.cs
@@ -0,0 +1,187 @@
+using System.Net;
+using System.Net.Sockets;
+
+namespace Auricrux.Web.Security;
+
+/// <summary>The outcome of validating an outbound fetch target.</summary>
+/// <param name="Allowed">Whether the fetch may proceed.</param>
+/// <param name="Reason">Operator-facing explanation when the fetch was refused.</param>
+/// <param name="ResolvedAddresses">Addresses the host resolved to, for audit logging.</param>
+public sealed record UrlGuardResult(bool Allowed, string? Reason, IReadOnlyList<IPAddress> ResolvedAddresses)
+{
+    /// <summary>A permitted target.</summary>
+    public static UrlGuardResult Allow(IReadOnlyList<IPAddress> addresses) => new(true, null, addresses);
+
+    /// <summary>A refused target.</summary>
+    public static UrlGuardResult Deny(string reason) => new(false, reason, []);
+}
+
+/// <summary>
+/// Validates outbound fetch targets before the application will retrieve them.
+///
+/// A hostname allow/deny list alone is not an SSRF control: <c>evil.example.com</c> can resolve
+/// to 169.254.169.254 and an allowed public host can redirect to one. This guard therefore
+/// resolves the host and rejects the request unless *every* address it resolves to is a public
+/// unicast address, covering IPv6 and IPv4-mapped IPv6 as well as IPv4. Callers must also
+/// re-validate each redirect hop, since DNS can be re-pointed between checks.
+/// </summary>
+public sealed class OutboundUrlGuard(IConfiguration config, ILogger<OutboundUrlGuard> logger)
+{
+    /// <summary>Validates <paramref name="uri"/> as an outbound fetch target.</summary>
+    public async Task<UrlGuardResult> ValidateAsync(Uri uri, CancellationToken ct = default)
+    {
+        if (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps)
+        {
+            return UrlGuardResult.Deny("Only http and https URLs are allowed.");
+        }
+
+        if (uri.Scheme == Uri.UriSchemeHttp && !config.GetValue("WebBrowse:AllowPlainHttp", true))
+        {
+            return UrlGuardResult.Deny("Plain http is disabled; use https.");
+        }
+
+        var host = uri.DnsSafeHost;
+        if (string.IsNullOrWhiteSpace(host))
+        {
+            return UrlGuardResult.Deny("URL has no host.");
+        }
+
+        if (IsBlockedName(host))
+        {
+            return UrlGuardResult.Deny("Host is blocked (link-local, loopback, or cloud metadata name).");
+        }
+
+        var denyHosts = config.GetSection("WebBrowse:DeniedHosts").Get<string[]>() ?? [];
+        if (denyHosts.Any(h => host.Equals(h?.Trim(), StringComparison.OrdinalIgnoreCase)))
+        {
+            return UrlGuardResult.Deny("Host is on the deny list.");
+        }
+
+        var allowHosts = config.GetSection("WebBrowse:AllowedHosts").Get<string[]>() ?? [];
+        if (allowHosts.Length > 0
+            && !allowHosts.Any(h => host.Equals(h?.Trim(), StringComparison.OrdinalIgnoreCase)
+                                    || host.EndsWith("." + h?.Trim(), StringComparison.OrdinalIgnoreCase)))
+        {
+            return UrlGuardResult.Deny("Host is not on the configured allow list.");
+        }
+
+        IPAddress[] addresses;
+        if (IPAddress.TryParse(host, out var literal))
+        {
+            addresses = [literal];
+        }
+        else
+        {
+            try
+            {
+                addresses = await Dns.GetHostAddressesAsync(host, ct);
+            }
+            catch (Exception ex)
+            {
+                logger.LogWarning(ex, "SSRF guard could not resolve {Host}", host);
+                return UrlGuardResult.Deny($"Could not resolve host '{host}'.");
+            }
+        }
+
+        if (addresses.Length == 0)
+        {
+            return UrlGuardResult.Deny($"Host '{host}' resolved to no addresses.");
+        }
+
+        // Every address must be public: a host resolving to both a public and a private address
+        // would otherwise be exploitable by retrying until the private one is selected.
+        foreach (var address in addresses)
+        {
+            if (!IsPublicUnicast(address))
+            {
+                logger.LogWarning("SSRF guard blocked {Host} resolving to non-public {Address}", host, address);
+                return UrlGuardResult.Deny($"Host '{host}' resolves to a non-public address and is blocked.");
+            }
+        }
+
+        return UrlGuardResult.Allow(addresses);
+    }
+
+    private static bool IsBlockedName(string host)
+    {
+        var h = host.Trim().TrimEnd('.').ToLowerInvariant();
+        if (h.Length == 0)
+        {
+            return true;
+        }
+
+        if (h is "localhost" or "metadata" or "metadata.google.internal" or "instance-data")
+        {
+            return true;
+        }
+
+        return h.EndsWith(".localhost", StringComparison.Ordinal)
+               || h.EndsWith(".local", StringComparison.Ordinal)
+               || h.EndsWith(".internal", StringComparison.Ordinal)
+               || h.EndsWith(".localdomain", StringComparison.Ordinal);
+    }
+
+    /// <summary>
+    /// Whether <paramref name="address"/> is a globally routable unicast address. Everything
+    /// else — loopback, private, link-local (including the 169.254.169.254 metadata endpoint),
+    /// carrier-grade NAT, multicast, and reserved space — is refused.
+    /// </summary>
+    public static bool IsPublicUnicast(IPAddress address)
+    {
+        if (address.IsIPv4MappedToIPv6)
+        {
+            address = address.MapToIPv4();
+        }
+
+        if (IPAddress.IsLoopback(address) || address.Equals(IPAddress.Any) || address.Equals(IPAddress.IPv6Any))
+        {
+            return false;
+        }
+
+        if (address.AddressFamily == AddressFamily.InterNetwork)
+        {
+            var b = address.GetAddressBytes();
+            return b[0] switch
+            {
+                0 => false,                                   // 0.0.0.0/8 "this network"
+                10 => false,                                  // 10.0.0.0/8 private
+                127 => false,                                 // loopback
+                169 when b[1] == 254 => false,                // link-local, incl. cloud metadata
+                172 when b[1] >= 16 && b[1] <= 31 => false,   // 172.16.0.0/12 private
+                192 when b[1] == 168 => false,                // 192.168.0.0/16 private
+                192 when b[1] == 0 && b[2] == 0 => false,     // 192.0.0.0/24 IETF protocol assignments
+                192 when b[1] == 0 && b[2] == 2 => false,     // TEST-NET-1
+                198 when b[1] == 18 || b[1] == 19 => false,   // benchmarking
+                198 when b[1] == 51 && b[2] == 100 => false,  // TEST-NET-2
+                203 when b[1] == 0 && b[2] == 113 => false,   // TEST-NET-3
+                100 when b[1] >= 64 && b[1] <= 127 => false,  // 100.64.0.0/10 carrier-grade NAT
+                >= 224 => false,                              // multicast and reserved
+                _ => true
+            };
+        }
+
+        if (address.AddressFamily == AddressFamily.InterNetworkV6)
+        {
+            if (address.IsIPv6LinkLocal || address.IsIPv6SiteLocal || address.IsIPv6Multicast
+                || address.IsIPv6UniqueLocal || address.IsIPv6Teredo)
+            {
+                return false;
+            }
+
+            var b = address.GetAddressBytes();
+            if (b[0] == 0x01 && b[1] == 0x00 && b[2] == 0x00 && b[3] == 0x00)
+            {
+                return false; // 100::/64 discard-only
+            }
+
+            if (b[0] == 0x20 && b[1] == 0x01 && b[2] == 0x00 && (b[3] & 0xF0) == 0x00)
+            {
+                return false; // 2001:0::/32 Teredo and 2001:db8::/32 documentation neighbours
+            }
+
+            return true;
+        }
+
+        return false;
+    }
+}
