@@ -0,0 +1,121 @@
+using System.Net;
+using System.Net.Http.Json;
+using Auricrux.Shared.Models;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.Extensions.Configuration;
+using Xunit;
+
+namespace Auricrux.Tests;
+
+/// <summary>
+/// Host configured the way a real paid deployment should be: the checkout backend holds a
+/// provisioning key, and only a caller presenting that key may move an account between plans.
+/// </summary>
+public sealed class BillingProvisionedWebApplicationFactory : WebApplicationFactory<Program>
+{
+    public const string ProvisioningKey = "test-provisioning-key-2f8c41d9";
+
+    protected override void ConfigureWebHost(IWebHostBuilder builder)
+    {
+        builder.ConfigureAppConfiguration((_, config) =>
+        {
+            config.AddInMemoryCollection(new Dictionary<string, string?>
+            {
+                ["Billing:ProvisioningKey"] = ProvisioningKey
+            });
+        });
+    }
+}
+
+/// <summary>
+/// Covers the entitlement boundary that protects revenue: an upgrade must be provable, and the
+/// plan it grants must actually change what the caller can do.
+/// </summary>
+public sealed class BillingProvisioningTests : IClassFixture<BillingProvisionedWebApplicationFactory>
+{
+    private readonly HttpClient _client;
+
+    public BillingProvisioningTests(BillingProvisionedWebApplicationFactory factory)
+    {
+        _client = factory.CreateClient();
+    }
+
+    [Fact]
+    public async Task Upgrade_with_provisioning_key_unlocks_higher_limit_and_models()
+    {
+        var email = $"billing-upgrade-{Guid.NewGuid():N}@test.local";
+        await _client.PostAsJsonAsync("/api/account/register", new { email });
+
+        using var beforeUpgrade = new HttpRequestMessage(HttpMethod.Post, "/api/chat?model=mistral")
+        {
+            Content = JsonContent.Create(new ChatRequest { Query = "What is a sill plate?" })
+        };
+        beforeUpgrade.Headers.TryAddWithoutValidation("X-Auricrux-Email", email);
+        var forbidden = await _client.SendAsync(beforeUpgrade);
+        Assert.Equal(HttpStatusCode.Forbidden, forbidden.StatusCode);
+
+        using var upgradeRequest = new HttpRequestMessage(HttpMethod.Post, $"/api/account/{email}/upgrade")
+        {
+            Content = JsonContent.Create(new { plan = "pro" })
+        };
+        upgradeRequest.Headers.TryAddWithoutValidation(
+            "X-Auricrux-Provisioning-Key",
+            BillingProvisionedWebApplicationFactory.ProvisioningKey);
+
+        var upgrade = await _client.SendAsync(upgradeRequest);
+        Assert.Equal(HttpStatusCode.OK, upgrade.StatusCode);
+
+        var upgraded = await upgrade.Content.ReadFromJsonAsync<AccountPayload>();
+        Assert.NotNull(upgraded);
+        Assert.Equal("pro", upgraded!.Plan);
+        Assert.Equal(500, upgraded.DailyQueryLimit);
+
+        using var afterUpgrade = new HttpRequestMessage(HttpMethod.Post, "/api/chat?model=mistral")
+        {
+            Content = JsonContent.Create(new ChatRequest { Query = "What is a sill plate?" })
+        };
+        afterUpgrade.Headers.TryAddWithoutValidation("X-Auricrux-Email", email);
+        var allowed = await _client.SendAsync(afterUpgrade);
+        Assert.Equal(HttpStatusCode.OK, allowed.StatusCode);
+    }
+
+    [Fact]
+    public async Task Upgrade_without_provisioning_key_is_forbidden()
+    {
+        var email = $"billing-nokey-{Guid.NewGuid():N}@test.local";
+        await _client.PostAsJsonAsync("/api/account/register", new { email });
+
+        var upgrade = await _client.PostAsJsonAsync($"/api/account/{email}/upgrade", new { plan = "pro-plus" });
+        Assert.Equal(HttpStatusCode.Forbidden, upgrade.StatusCode);
+    }
+
+    [Fact]
+    public async Task Upgrade_with_wrong_provisioning_key_is_forbidden()
+    {
+        var email = $"billing-badkey-{Guid.NewGuid():N}@test.local";
+        await _client.PostAsJsonAsync("/api/account/register", new { email });
+
+        using var request = new HttpRequestMessage(HttpMethod.Post, $"/api/account/{email}/upgrade")
+        {
+            Content = JsonContent.Create(new { plan = "pro-plus" })
+        };
+        request.Headers.TryAddWithoutValidation("X-Auricrux-Provisioning-Key", "not-the-key");
+
+        var upgrade = await _client.SendAsync(request);
+        Assert.Equal(HttpStatusCode.Forbidden, upgrade.StatusCode);
+
+        var check = await _client.GetAsync($"/api/account/{email}");
+        var account = await check.Content.ReadFromJsonAsync<AccountPayload>();
+        Assert.NotNull(account);
+        Assert.Equal("free", account!.Plan);
+    }
+
+    private sealed class AccountPayload
+    {
+        public string Email { get; set; } = string.Empty;
+        public string Plan { get; set; } = string.Empty;
+        public int DailyQueryLimit { get; set; }
+        public int QueriesUsedToday { get; set; }
+    }
+}
