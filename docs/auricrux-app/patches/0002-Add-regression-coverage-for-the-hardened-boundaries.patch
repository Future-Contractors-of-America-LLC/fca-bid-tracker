+using System.Net;
+using Auricrux.Web.Security;
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.Logging.Abstractions;
+using Xunit;
+
+namespace Auricrux.Tests;
+
+/// <summary>
+/// Covers the SSRF boundary. The property that matters is that the decision is made against the
+/// addresses a host actually resolves to, not against the spelling of the hostname — a name-only
+/// blocklist is bypassed by any attacker-controlled DNS record pointing at internal space.
+/// </summary>
+public sealed class OutboundUrlGuardTests
+{
+    private static OutboundUrlGuard Guard(params (string Key, string Value)[] settings)
+    {
+        var config = new ConfigurationBuilder()
+            .AddInMemoryCollection(settings.ToDictionary(s => s.Key, s => (string?)s.Value))
+            .Build();
+        return new OutboundUrlGuard(config, NullLogger<OutboundUrlGuard>.Instance);
+    }
+
+    [Theory]
+    [InlineData("169.254.169.254")]   // AWS/Azure/GCP instance metadata
+    [InlineData("127.0.0.1")]
+    [InlineData("10.1.2.3")]
+    [InlineData("172.16.0.1")]
+    [InlineData("172.31.255.254")]
+    [InlineData("192.168.1.1")]
+    [InlineData("100.64.0.1")]        // carrier-grade NAT
+    [InlineData("0.0.0.0")]
+    [InlineData("224.0.0.1")]         // multicast
+    public void Private_and_reserved_ipv4_literals_are_blocked(string address)
+    {
+        Assert.False(OutboundUrlGuard.IsPublicUnicast(IPAddress.Parse(address)));
+    }
+
+    [Theory]
+    [InlineData("::1")]                        // loopback
+    [InlineData("fe80::1")]                    // link-local
+    [InlineData("fc00::1")]                    // unique local
+    [InlineData("fd12:3456:789a::1")]          // unique local
+    [InlineData("::ffff:169.254.169.254")]     // IPv4-mapped metadata address
+    [InlineData("::ffff:127.0.0.1")]           // IPv4-mapped loopback
+    public void Private_and_mapped_ipv6_literals_are_blocked(string address)
+    {
+        Assert.False(OutboundUrlGuard.IsPublicUnicast(IPAddress.Parse(address)));
+    }
+
+    [Theory]
+    [InlineData("8.8.8.8")]
+    [InlineData("1.1.1.1")]
+    [InlineData("2606:4700:4700::1111")]
+    public void Public_addresses_are_allowed(string address)
+    {
+        Assert.True(OutboundUrlGuard.IsPublicUnicast(IPAddress.Parse(address)));
+    }
+
+    [Fact]
+    public async Task Metadata_endpoint_is_refused()
+    {
+        var result = await Guard().ValidateAsync(new Uri("http://169.254.169.254/latest/meta-data/"));
+        Assert.False(result.Allowed);
+    }
+
+    [Fact]
+    public async Task Loopback_by_name_is_refused()
+    {
+        var result = await Guard().ValidateAsync(new Uri("http://localhost:11434/api/chat"));
+        Assert.False(result.Allowed);
+    }
+
+    [Theory]
+    [InlineData("http://metadata.google.internal/computeMetadata/v1/")]
+    [InlineData("http://something.internal/secrets")]
+    [InlineData("http://printer.local/admin")]
+    public async Task Internal_naming_conventions_are_refused(string url)
+    {
+        var result = await Guard().ValidateAsync(new Uri(url));
+        Assert.False(result.Allowed);
+    }
+
+    [Theory]
+    [InlineData("file:///etc/passwd")]
+    [InlineData("gopher://example.com/")]
+    [InlineData("ftp://example.com/")]
+    public async Task Non_http_schemes_are_refused(string url)
+    {
+        var result = await Guard().ValidateAsync(new Uri(url));
+        Assert.False(result.Allowed);
+    }
+
+    [Fact]
+    public async Task Unresolvable_host_is_refused_rather_than_attempted()
+    {
+        var result = await Guard().ValidateAsync(
+            new Uri("https://this-host-does-not-exist-auricrux-test.invalid/"));
+        Assert.False(result.Allowed);
+    }
+
+    [Fact]
+    public async Task Allow_list_excludes_hosts_that_are_not_on_it()
+    {
+        var guard = Guard(("WebBrowse:AllowedHosts:0", "example.com"));
+        var result = await guard.ValidateAsync(new Uri("https://not-example.org/"));
+
+        Assert.False(result.Allowed);
+        Assert.Contains("allow list", result.Reason, StringComparison.OrdinalIgnoreCase);
+    }
+
+    [Fact]
+    public async Task Deny_list_blocks_an_otherwise_public_host()
+    {
+        var guard = Guard(("WebBrowse:DeniedHosts:0", "example.com"));
+        var result = await guard.ValidateAsync(new Uri("https://example.com/"));
+
+        Assert.False(result.Allowed);
+        Assert.Contains("deny list", result.Reason, StringComparison.OrdinalIgnoreCase);
+    }
+
+    [Fact]
+    public async Task Plain_http_can_be_disabled()
+    {
+        var guard = Guard(("WebBrowse:AllowPlainHttp", "false"));
+        var result = await guard.ValidateAsync(new Uri("http://example.com/"));
+
+        Assert.False(result.Allowed);
+    }
+}
