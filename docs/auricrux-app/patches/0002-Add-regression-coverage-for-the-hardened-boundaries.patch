+using Auricrux.Web.Services;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.Extensions.FileProviders;
+using Xunit;
+
+namespace Auricrux.Tests;
+
+/// <summary>
+/// Covers the storage boundary between accounts. Workspace paths and conversation session ids are
+/// both caller-chosen, so isolation cannot rely on them being unguessable — it has to come from
+/// the tenant partition.
+/// </summary>
+public sealed class TenantIsolationTests : IDisposable
+{
+    private readonly string _contentRoot;
+    private readonly IWebHostEnvironment _env;
+
+    public TenantIsolationTests()
+    {
+        _contentRoot = Path.Combine(Path.GetTempPath(), "auricrux-tenant-tests", Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(_contentRoot);
+        _env = new TestEnvironment(_contentRoot);
+    }
+
+    public void Dispose()
+    {
+        try
+        {
+            Directory.Delete(_contentRoot, recursive: true);
+        }
+        catch (IOException)
+        {
+            // A leftover temp directory must not fail the run.
+        }
+    }
+
+    [Fact]
+    public async Task Workspace_file_written_by_one_tenant_is_invisible_to_another()
+    {
+        var workspace = new WorkspaceStorageService(_env);
+        const string sharedPath = "project-alpha";
+
+        using var content = new MemoryStream("tenant-a confidential bid"u8.ToArray());
+        await workspace.SaveFileAsync("tenant-a", sharedPath, "bid.txt", content);
+
+        var listedByOwner = workspace.List("tenant-a", sharedPath);
+        Assert.Contains(listedByOwner.Entries, e => e.Name == "bid.txt");
+
+        // Same path, different tenant: the file must not be reachable by listing or by direct read.
+        var listedByOther = workspace.List("tenant-b", sharedPath);
+        Assert.DoesNotContain(listedByOther.Entries, e => e.Name == "bid.txt");
+        Assert.Null(workspace.OpenFile("tenant-b", $"{sharedPath}/bid.txt"));
+    }
+
+    [Fact]
+    public async Task Workspace_delete_by_another_tenant_does_not_remove_the_owner_file()
+    {
+        var workspace = new WorkspaceStorageService(_env);
+
+        using var content = new MemoryStream("keep me"u8.ToArray());
+        await workspace.SaveFileAsync("tenant-a", "shared", "rfi.txt", content);
+
+        Assert.False(workspace.Delete("tenant-b", "shared/rfi.txt"));
+        Assert.NotNull(workspace.OpenFile("tenant-a", "shared/rfi.txt"));
+    }
+
+    [Theory]
+    [InlineData("../../../etc/passwd")]
+    [InlineData("..\\..\\windows\\system32")]
+    [InlineData("nested/../../escape.txt")]
+    public void Workspace_rejects_traversal_out_of_the_tenant_root(string path)
+    {
+        var workspace = new WorkspaceStorageService(_env);
+        Assert.Throws<InvalidOperationException>(() => workspace.CreateFolder("tenant-a", path));
+    }
+
+    [Theory]
+    [InlineData(MemoryBackend.Session)]
+    [InlineData(MemoryBackend.FileJsonl)]
+    [InlineData(MemoryBackend.Sqlite)]
+    public async Task Conversation_with_a_known_session_id_is_not_readable_by_another_tenant(MemoryBackend backend)
+    {
+        var memory = new ConversationMemoryService(_env);
+        const string sessionId = "session-known-to-both";
+
+        await memory.AppendAsync("tenant-a", sessionId, backend, "user", "our bid number is 4471");
+
+        var owner = await memory.ListAsync("tenant-a", sessionId, backend);
+        Assert.Single(owner);
+        Assert.Contains("4471", owner[0].Content, StringComparison.Ordinal);
+
+        var other = await memory.ListAsync("tenant-b", sessionId, backend);
+        Assert.Empty(other);
+    }
+
+    [Fact]
+    public async Task Listed_turns_report_the_logical_session_id_not_the_storage_key()
+    {
+        var memory = new ConversationMemoryService(_env);
+        const string sessionId = "session-visible-id";
+
+        await memory.AppendAsync("tenant-a", sessionId, MemoryBackend.Sqlite, "user", "hello");
+        var turns = await memory.ListAsync("tenant-a", sessionId, MemoryBackend.Sqlite);
+
+        Assert.Single(turns);
+        Assert.Equal(sessionId, turns[0].SessionId);
+    }
+
+    private sealed class TestEnvironment(string contentRoot) : IWebHostEnvironment
+    {
+        public string ApplicationName { get; set; } = "Auricrux.Tests";
+        public IFileProvider ContentRootFileProvider { get; set; } = new PhysicalFileProvider(contentRoot);
+        public string ContentRootPath { get; set; } = contentRoot;
+        public string EnvironmentName { get; set; } = "Development";
+        public IFileProvider WebRootFileProvider { get; set; } = new PhysicalFileProvider(contentRoot);
+        public string WebRootPath { get; set; } = contentRoot;
+    }
+}
