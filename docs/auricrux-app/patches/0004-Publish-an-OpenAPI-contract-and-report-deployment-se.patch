+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Xunit;
+
+namespace Auricrux.Tests;
+
+/// <summary>
+/// Covers the surfaces an operator or integrator relies on: the published contract, the split
+/// health probes, and the deployment's self-reported security posture.
+/// </summary>
+public sealed class PlatformSurfaceTests : IClassFixture<WebApplicationFactory<Program>>
+{
+    private readonly HttpClient _client;
+
+    public PlatformSurfaceTests(WebApplicationFactory<Program> factory)
+    {
+        _client = factory.CreateClient();
+    }
+
+    [Fact]
+    public async Task OpenApi_document_is_served_and_describes_the_api()
+    {
+        var response = await _client.GetAsync("/openapi/v1.json");
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+
+        using var document = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
+        var paths = document.RootElement.GetProperty("paths");
+
+        Assert.True(paths.TryGetProperty("/api/chat", out _), "Contract should describe /api/chat.");
+        Assert.True(paths.TryGetProperty("/api/chat/stream", out _), "Contract should describe the streaming route.");
+        Assert.True(paths.TryGetProperty("/api/agent", out _), "Contract should describe /api/agent.");
+    }
+
+    /// <summary>
+    /// Liveness must not depend on upstreams. If it did, a model backend outage would restart every
+    /// replica instead of degrading answers.
+    /// </summary>
+    [Fact]
+    public async Task Liveness_is_independent_of_upstream_reachability()
+    {
+        var response = await _client.GetAsync("/livez");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var body = await response.Content.ReadAsStringAsync();
+        Assert.Contains("alive", body, StringComparison.OrdinalIgnoreCase);
+    }
+
+    [Fact]
+    public async Task Readiness_reports_a_status()
+    {
+        var response = await _client.GetAsync("/readyz");
+
+        // Degraded is expected here: these tests run with no model backend reachable.
+        Assert.True(
+            response.StatusCode is HttpStatusCode.OK or HttpStatusCode.ServiceUnavailable,
+            $"Unexpected readiness status {(int)response.StatusCode}.");
+    }
+
+    [Fact]
+    public async Task Capabilities_report_declares_streaming_as_shipped()
+    {
+        var response = await _client.GetAsync("/api/capabilities");
+        using var document = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
+
+        var streaming = document.RootElement
+            .GetProperty("competitiveMatrix")
+            .EnumerateArray()
+            .Single(row => row.GetProperty("feature").GetString() == "Streaming responses");
+
+        Assert.Equal("shipped", streaming.GetProperty("auricrux").GetString());
+    }
+
+    /// <summary>
+    /// The posture block exists so an open deployment is visible from the API. These tests run
+    /// without authentication configured, so it must say so rather than reporting a clean bill.
+    /// </summary>
+    [Fact]
+    public async Task Capabilities_report_admits_an_open_deployment()
+    {
+        var response = await _client.GetAsync("/api/capabilities");
+        using var document = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
+
+        var posture = document.RootElement.GetProperty("securityPosture");
+
+        Assert.False(posture.GetProperty("authenticationEnabled").GetBoolean());
+        Assert.False(posture.GetProperty("defaultDenyApi").GetBoolean());
+        Assert.True(posture.GetProperty("planChangesRequireCredential").GetBoolean());
+        Assert.True(posture.GetProperty("promptInjectionIsolation").GetBoolean());
+
+        var warnings = posture.GetProperty("warnings").EnumerateArray().Select(w => w.GetString()!).ToList();
+        Assert.Contains(warnings, w => w.Contains("Auth:Enabled is off", StringComparison.OrdinalIgnoreCase));
+    }
+
+    [Fact]
+    public async Task Correlation_id_from_a_client_is_sanitized_before_being_echoed()
+    {
+        using var request = new HttpRequestMessage(HttpMethod.Get, "/api/health");
+        request.Headers.TryAddWithoutValidation("X-Correlation-Id", "abc\r\nInjected-Header: evil");
+
+        var response = await _client.SendAsync(request);
+        var echoed = response.Headers.GetValues("X-Correlation-Id").Single();
+
+        Assert.DoesNotContain('\r', echoed);
+        Assert.DoesNotContain('\n', echoed);
+        Assert.DoesNotContain(' ', echoed);
+        Assert.False(response.Headers.Contains("Injected-Header"));
+    }
+
+    [Fact]
+    public async Task Correlation_id_is_generated_when_the_client_supplies_none()
+    {
+        var response = await _client.GetAsync("/api/health");
+        var correlationId = response.Headers.GetValues("X-Correlation-Id").Single();
+
+        Assert.False(string.IsNullOrWhiteSpace(correlationId));
+    }
+
+    [Fact]
+    public async Task Browse_refuses_a_cloud_metadata_target()
+    {
+        var response = await _client.PostAsJsonAsync("/api/browse", new
+        {
+            url = "http://169.254.169.254/latest/meta-data/iam/security-credentials/"
+        });
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        var body = await response.Content.ReadAsStringAsync();
+        Assert.Contains("non-public", body, StringComparison.OrdinalIgnoreCase);
+    }
+
+    [Fact]
+    public async Task Browse_refuses_a_loopback_target_named_by_hostname()
+    {
+        var response = await _client.PostAsJsonAsync("/api/browse", new
+        {
+            url = "http://localhost:11434/api/tags"
+        });
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Security_headers_are_applied_to_api_responses()
+    {
+        var response = await _client.GetAsync("/api/health");
+
+        Assert.Equal("nosniff", response.Headers.GetValues("X-Content-Type-Options").Single());
+        Assert.Equal("DENY", response.Headers.GetValues("X-Frame-Options").Single());
+        Assert.Contains("frame-ancestors 'none'", response.Headers.GetValues("Content-Security-Policy").Single());
+    }
+}
