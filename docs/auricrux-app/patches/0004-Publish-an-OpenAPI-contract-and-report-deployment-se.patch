+/// <summary>
+/// The security posture of the running deployment, including warnings about settings that leave
+/// it open.
+/// </summary>
+public sealed class SecurityPostureSummary
+{
+    /// <summary>Whether token authentication is enabled and an authority is configured.</summary>
+    public bool AuthenticationEnabled { get; set; }
+
+    /// <summary>Whether non-public API routes refuse anonymous callers.</summary>
+    public bool DefaultDenyApi { get; set; }
+
+    /// <summary>How stored data is partitioned between callers.</summary>
+    public string TenantIsolation { get; set; } = string.Empty;
+
+    /// <summary>Whether changing a plan requires a provisioning key or administrator identity.</summary>
+    public bool PlanChangesRequireCredential { get; set; }
+
+    /// <summary>How outbound fetch targets are validated.</summary>
+    public string SsrfGuard { get; set; } = string.Empty;
+
+    /// <summary>Whether retrieved content is isolated before entering a prompt.</summary>
+    public bool PromptInjectionIsolation { get; set; }
+
+    /// <summary>How request rate limiting is partitioned.</summary>
+    public string RateLimiting { get; set; } = string.Empty;
+
+    /// <summary>Configuration that leaves this deployment more open than recommended.</summary>
+    public IReadOnlyList<string> Warnings { get; set; } = [];
+}
