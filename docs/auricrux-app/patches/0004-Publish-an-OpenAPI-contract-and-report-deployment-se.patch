+    /// <summary>
+    /// Reports the security-relevant configuration of this running deployment. An operator should
+    /// be able to see that they are running open from the API rather than discovering it during an
+    /// incident, so these values describe what is actually in effect, not what is recommended.
+    /// </summary>
+    private SecurityPostureSummary BuildSecurityPosture()
+    {
+        var authEnabled = config.GetValue("Auth:Enabled", false)
+                          && !string.IsNullOrWhiteSpace(config["Auth:Authority"]);
+        var allowUnauthenticatedPlanChanges = config.GetValue("Billing:AllowUnauthenticatedPlanChanges", false);
+
+        var warnings = new List<string>();
+        if (!authEnabled)
+        {
+            warnings.Add("Auth:Enabled is off — all callers are anonymous and share one storage partition. Treat as single-tenant.");
+        }
+
+        if (allowUnauthenticatedPlanChanges)
+        {
+            warnings.Add("Billing:AllowUnauthenticatedPlanChanges is on — any caller can change any account's plan.");
+        }
+
+        if (!planChangeAuthorizer.IsConfigured)
+        {
+            warnings.Add("No Billing:ProvisioningKey or Auth:AdminEmails — plan upgrades are refused.");
+        }
+
+        if (string.Equals(config["AllowedHosts"], "*", StringComparison.Ordinal))
+        {
+            warnings.Add("AllowedHosts is '*' — set explicit hostnames to reject host-header spoofing.");
+        }
+
+        if (!authEnabled && !config.GetValue("Billing:RequireIdentity", false))
+        {
+            warnings.Add("Billing:RequireIdentity is off — anonymous callers are not metered against any quota.");
+        }
+
+        return new SecurityPostureSummary
+        {
+            AuthenticationEnabled = authEnabled,
+            DefaultDenyApi = authEnabled,
+            TenantIsolation = authEnabled ? "per-account" : "single-tenant (anonymous partition)",
+            PlanChangesRequireCredential = !allowUnauthenticatedPlanChanges,
+            SsrfGuard = "resolved-address validation, IPv4/IPv6, per-redirect-hop",
+            PromptInjectionIsolation = true,
+            RateLimiting = "per-account with client-address fallback, plus a global backstop",
+            Warnings = warnings
+        };
+    }
