diff --git a/.github/workflows/security-scan.yml b/.github/workflows/security-scan.yml
new file mode 100644
index 0000000..63c43a0
--- /dev/null
+++ b/.github/workflows/security-scan.yml
@@ -0,0 +1,106 @@
+name: Security Scan
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+    branches: [main]
+  schedule:
+    # Advisories are published against dependencies that are already merged, so a scan that only
+    # runs on push would not notice a package becoming vulnerable after the fact.
+    - cron: '0 6 * * 1'
+  workflow_dispatch:
+
+permissions:
+  contents: read
+  security-events: write
+
+jobs:
+  dependency-audit:
+    name: Dependency audit
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Setup .NET
+        uses: actions/setup-dotnet@v4
+        with:
+          dotnet-version: '10.0.x'
+
+      - name: Restore
+        run: dotnet restore AuricruxApp.sln
+
+      - name: Fail on vulnerable packages
+        run: |
+          dotnet list AuricruxApp.sln package --vulnerable --include-transitive 2>&1 | tee audit.log
+          if grep -qE '\|\s+(Critical|High|Moderate)' audit.log; then
+            echo "::error::Vulnerable NuGet packages detected. Review audit.log output above."
+            exit 1
+          fi
+          echo "No vulnerable packages at Moderate or above."
+
+      - name: Report deprecated packages
+        continue-on-error: true
+        run: dotnet list AuricruxApp.sln package --deprecated
+
+  codeql:
+    name: CodeQL
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Setup .NET
+        uses: actions/setup-dotnet@v4
+        with:
+          dotnet-version: '10.0.x'
+
+      - name: Initialize CodeQL
+        uses: github/codeql-action/init@v3
+        with:
+          languages: csharp
+          queries: security-and-quality
+
+      # Built explicitly rather than by autobuild: the solution excludes the MAUI project, and
+      # autobuild would try to restore workloads this runner does not have.
+      - name: Build
+        run: dotnet build AuricruxApp.sln -c Release
+
+      - name: Analyze
+        uses: github/codeql-action/analyze@v3
+        with:
+          category: /language:csharp
+
+  secret-scan:
+    name: Secret scan
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - name: Scan history for committed credentials
+        uses: gitleaks/gitleaks-action@v2
+        env:
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+
+  security-tests:
+    name: Security regression tests
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Setup .NET
+        uses: actions/setup-dotnet@v4
+        with:
+          dotnet-version: '10.0.x'
+
+      - name: Build
+        run: dotnet build AuricruxApp.sln -c Release
+
+      # Run the boundary suites by name so a rename or accidental deletion fails the job rather
+      # than silently reducing coverage of the controls they protect.
+      - name: Run boundary suites
+        run: |
+          dotnet test Auricrux.Tests/Auricrux.Tests.csproj -c Release --no-build \
+            --filter "FullyQualifiedName~OutboundUrlGuardTests|FullyQualifiedName~UntrustedContentTests|FullyQualifiedName~TenantIsolationTests|FullyQualifiedName~AuthEnabledTests|FullyQualifiedName~BillingProvisioningTests" \
+            --logger "console;verbosity=normal"
