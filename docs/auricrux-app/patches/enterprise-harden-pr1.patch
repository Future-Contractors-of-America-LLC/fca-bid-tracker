+    /// <summary>
+    /// Open-dev (Auth disabled): upgrades remain callable for freemium tests.
+    /// Auth-enabled: caller must be the same principal, or present Commerce:UpgradeKey.
+    /// </summary>
+    private bool CanUpgrade(string email, string? upgradeKey)
+    {
+        if (!PrincipalResolver.IsProductAuthRequired(config))
+        {
+            return true;
+        }
+
+        var configuredKey = config["Commerce:UpgradeKey"];
+        if (!string.IsNullOrWhiteSpace(configuredKey)
+            && !string.IsNullOrWhiteSpace(upgradeKey)
+            && string.Equals(configuredKey, upgradeKey, StringComparison.Ordinal))
+        {
+            return true;
+        }
+
+        var principal = PrincipalResolver.ResolveEmail(HttpContext, config);
+        return !string.IsNullOrWhiteSpace(principal)
+               && string.Equals(principal, email, StringComparison.OrdinalIgnoreCase);
+    }
+
