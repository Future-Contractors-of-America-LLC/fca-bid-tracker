@@ -0,0 +1,64 @@
+using System.Text.Json;
+using System.Collections.Concurrent;
+
+namespace Auricrux.Web.Services;
+
+/// <summary>
+/// Append-only audit trail for enterprise accountability (actor, route, correlation, model).
+/// Persists JSONL under Data/audit; also keeps a bounded in-memory ring for health probes.
+/// </summary>
+public sealed class AuditLogService
+{
+    private readonly IWebHostEnvironment _env;
+    private readonly ILogger<AuditLogService> _logger;
+    private readonly object _gate = new();
+    private readonly ConcurrentQueue<AuditEvent> _recent = new();
+    private const int MaxRecent = 200;
+
+    public AuditLogService(IWebHostEnvironment env, ILogger<AuditLogService> logger)
+    {
+        _env = env;
+        _logger = logger;
+        Directory.CreateDirectory(Root);
+    }
+
+    private string Root => Path.Combine(_env.ContentRootPath, "Data", "audit");
+    private string FilePath => Path.Combine(Root, "audit.jsonl");
+
+    public void Record(AuditEvent evt)
+    {
+        evt.TimestampUtc ??= DateTime.UtcNow;
+        _recent.Enqueue(evt);
+        while (_recent.Count > MaxRecent && _recent.TryDequeue(out _)) { }
+
+        try
+        {
+            var line = JsonSerializer.Serialize(evt) + Environment.NewLine;
+            lock (_gate)
+            {
+                File.AppendAllText(FilePath, line);
+            }
+        }
+        catch (Exception ex)
+        {
+            _logger.LogWarning(ex, "Failed to persist audit event {Action}", evt.Action);
+        }
+    }
+
+    public IReadOnlyList<AuditEvent> Recent(int take = 50) =>
+        _recent.Reverse().Take(Math.Clamp(take, 1, MaxRecent)).ToList();
+}
+
+public sealed class AuditEvent
+{
+    public DateTime? TimestampUtc { get; set; }
+    public string Action { get; set; } = string.Empty;
+    public string? Actor { get; set; }
+    public string? Route { get; set; }
+    public string? CorrelationId { get; set; }
+    public string? SessionId { get; set; }
+    public string? Model { get; set; }
+    public string? Outcome { get; set; }
+    public long? DurationMs { get; set; }
+    public Dictionary<string, string>? Meta { get; set; }
+}
