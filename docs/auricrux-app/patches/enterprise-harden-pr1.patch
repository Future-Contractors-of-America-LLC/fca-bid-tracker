+    [HttpPost("chat/stream")]
+    public async Task ChatStream(
+        [FromBody] ChatRequest request,
+        [FromQuery] string? model,
+        [FromHeader(Name = "X-Auricrux-Email")] string? accountEmail,
+        CancellationToken cancellationToken)
+    {
+        if (string.IsNullOrWhiteSpace(request.Query))
+        {
+            Response.StatusCode = StatusCodes.Status400BadRequest;
+            await Response.WriteAsJsonAsync(new { error = "Query is required." }, cancellationToken);
+            return;
+        }
+
+        var mod = moderation.Evaluate(request.Query, "chat.stream");
+        if (!mod.Allowed)
+        {
+            Response.StatusCode = StatusCodes.Status422UnprocessableEntity;
+            await Response.WriteAsJsonAsync(new { error = mod.BlockReason }, cancellationToken);
+            return;
+        }
+
+        request.Query = mod.Text;
+        var resolvedEmail = PrincipalResolver.ResolveEmail(HttpContext, config, accountEmail);
+        model = ResolveModel(model, resolvedEmail, out var entitlementError);
+        if (entitlementError is not null)
+        {
+            var status = entitlementError is ObjectResult objectResult
+                ? objectResult.StatusCode ?? StatusCodes.Status403Forbidden
+                : StatusCodes.Status403Forbidden;
+            Response.StatusCode = status;
+            var body = entitlementError is ObjectResult withBody
+                ? withBody.Value
+                : new { error = "Entitlement failed." };
+            await Response.WriteAsJsonAsync(body, cancellationToken);
+            return;
+        }
+
+        Response.ContentType = "text/event-stream";
+        Response.Headers.CacheControl = "no-cache";
+        Response.Headers.Connection = "keep-alive";
+        await Response.StartAsync(cancellationToken);
+
+        await foreach (var evt in intelligence.StreamChatAsync(request, model, cancellationToken))
+        {
+            var payload = $"event: {evt.Event}\ndata: {EscapeSse(evt.Data)}\n\n";
+            await Response.Body.WriteAsync(Encoding.UTF8.GetBytes(payload), cancellationToken);
+            await Response.Body.FlushAsync(cancellationToken);
+        }
+
+        audit.Record(new AuditEvent
+        {
+            Action = "chat.stream",
+            Actor = resolvedEmail,
+            Route = "/api/chat/stream",
+            CorrelationId = HttpContext.TraceIdentifier,
+            SessionId = request.SessionId,
+            Model = model,
+            Outcome = "ok"
+        });
+    }
+
