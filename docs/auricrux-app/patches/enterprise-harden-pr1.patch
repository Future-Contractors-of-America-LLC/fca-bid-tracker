+using System.Security.Claims;
+
+namespace Auricrux.Web.Services;
+
+/// <summary>
+/// Resolves the calling principal for freemium/tenancy.
+/// When Auth is enabled, JWT/OIDC claims win over spoofable <c>X-Auricrux-Email</c>.
+/// When Auth is disabled (dev/tests), the header remains the identity signal.
+/// </summary>
+public static class PrincipalResolver
+{
+    public static string? ResolveEmail(HttpContext http, IConfiguration config, string? headerEmail = null)
+    {
+        var authEnabled = config.GetValue("Auth:Enabled", false);
+        if (authEnabled && http.User.Identity?.IsAuthenticated == true)
+        {
+            var claimEmail =
+                http.User.FindFirstValue(ClaimTypes.Email)
+                ?? http.User.FindFirstValue("email")
+                ?? http.User.FindFirstValue("preferred_username")
+                ?? http.User.Identity?.Name;
+            if (!string.IsNullOrWhiteSpace(claimEmail))
+            {
+                return claimEmail.Trim().ToLowerInvariant();
+            }
+        }
+
+        if (!authEnabled && !string.IsNullOrWhiteSpace(headerEmail))
+        {
+            return headerEmail.Trim().ToLowerInvariant();
+        }
+
+        // Auth enabled but no claim — do not trust client-supplied email.
+        if (authEnabled)
+        {
+            return null;
+        }
+
+        return string.IsNullOrWhiteSpace(headerEmail) ? null : headerEmail.Trim().ToLowerInvariant();
+    }
+
+    public static string TenantKey(HttpContext http, IConfiguration config, string? headerEmail = null)
+    {
+        var email = ResolveEmail(http, config, headerEmail);
+        if (!string.IsNullOrWhiteSpace(email))
+        {
+            return Sanitize(email);
+        }
+
+        if (http.User.Identity?.IsAuthenticated == true)
+        {
+            var sub = http.User.FindFirstValue(ClaimTypes.NameIdentifier)
+                      ?? http.User.FindFirstValue("sub");
+            if (!string.IsNullOrWhiteSpace(sub))
+            {
+                return Sanitize(sub);
+            }
+        }
+
+        return "anonymous";
+    }
+
+    public static bool IsProductAuthRequired(IConfiguration config) =>
+        config.GetValue("Auth:Enabled", false);
+
+    public static bool IsAuthenticated(HttpContext http) =>
+        http.User.Identity?.IsAuthenticated == true;
+
+    private static string Sanitize(string value)
+    {
+        var chars = value.Trim().ToLowerInvariant()
+            .Select(c => char.IsLetterOrDigit(c) || c is '-' or '_' or '.' or '@' ? c : '-')
+            .ToArray();
+        var s = new string(chars);
+        return string.IsNullOrWhiteSpace(s) ? "anonymous" : s;
+    }
+}
