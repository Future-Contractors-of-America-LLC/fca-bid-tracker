index 0000000..5049b16
--- /dev/null
+++ b/Auricrux.Web/Middleware/ProductAuthMiddleware.cs
@@ -0,0 +1,68 @@
+using Auricrux.Web.Services;
+
+namespace Auricrux.Web.Middleware;
+
+/// <summary>
+/// When <c>Auth:Enabled</c> is true, require authentication for product API routes.
+/// Public allowlist keeps health/capabilities/models/plans open for probes and login UX.
+/// Uses live <see cref="IConfiguration"/> so WebApplicationFactory overlays stay honest.
+/// </summary>
+public sealed class ProductAuthMiddleware(RequestDelegate next)
+{
+    private static readonly PathString[] AllowExact =
+    [
+        new("/api/health"),
+        new("/health"),
+        new("/healthz"),
+        new("/api/models"),
+        new("/api/capabilities"),
+        new("/api/account/plans"),
+        new("/account/auth-status"),
+        new("/api/secure/ping")
+    ];
+
+    public async Task InvokeAsync(HttpContext context, IConfiguration config)
+    {
+        if (!PrincipalResolver.IsProductAuthRequired(config))
+        {
+            await next(context);
+            return;
+        }
+
+        var path = context.Request.Path;
+        if (!path.StartsWithSegments("/api") && !path.StartsWithSegments("/media"))
+        {
+            await next(context);
+            return;
+        }
+
+        if (IsAllowListed(path) || IsRegister(path, context.Request.Method))
+        {
+            await next(context);
+            return;
+        }
+
+        if (!PrincipalResolver.IsAuthenticated(context))
+        {
+            context.Response.StatusCode = StatusCodes.Status401Unauthorized;
+            context.Response.ContentType = "application/json";
+            await context.Response.WriteAsJsonAsync(new { error = "Authentication required.", code = "auth_required" });
+            return;
+        }
+
+        await next(context);
+    }
+
+    private static bool IsAllowListed(PathString path) =>
+        AllowExact.Any(a => path.Equals(a, StringComparison.OrdinalIgnoreCase));
+
+    private static bool IsRegister(PathString path, string method) =>
+        HttpMethods.IsPost(method)
+        && path.Equals("/api/account/register", StringComparison.OrdinalIgnoreCase);
+}
+
+public static class ProductAuthMiddlewareExtensions
+{
+    public static IApplicationBuilder UseProductAuthGate(this IApplicationBuilder app) =>
+        app.UseMiddleware<ProductAuthMiddleware>();
+}
