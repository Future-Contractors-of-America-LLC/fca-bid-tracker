+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Auricrux.Shared.Models;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Xunit;
+
+namespace Auricrux.Tests;
+
+/// <summary>
+/// Covers incremental delivery of chat answers. These run without a reachable model, so they also
+/// prove the corpus fallback streams the same event shape as a live model — a client must not need
+/// to know which path served the answer.
+/// </summary>
+public sealed class ChatStreamingTests : IClassFixture<WebApplicationFactory<Program>>
+{
+    private readonly HttpClient _client;
+
+    public ChatStreamingTests(WebApplicationFactory<Program> factory)
+    {
+        _client = factory.CreateClient();
+    }
+
+    private async Task<List<(string Event, JsonElement Data)>> ReadStreamAsync(string query)
+    {
+        using var request = new HttpRequestMessage(HttpMethod.Post, "/api/chat/stream")
+        {
+            Content = JsonContent.Create(new ChatRequest { Query = query })
+        };
+
+        using var response = await _client.SendAsync(request, HttpCompletionOption.ResponseHeadersRead);
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        Assert.Equal("text/event-stream", response.Content.Headers.ContentType?.MediaType);
+
+        var events = new List<(string, JsonElement)>();
+        await using var stream = await response.Content.ReadAsStreamAsync();
+        using var reader = new StreamReader(stream);
+
+        string? currentEvent = null;
+        while (await reader.ReadLineAsync() is { } line)
+        {
+            if (line.StartsWith("event: ", StringComparison.Ordinal))
+            {
+                currentEvent = line["event: ".Length..];
+            }
+            else if (line.StartsWith("data: ", StringComparison.Ordinal))
+            {
+                var json = JsonDocument.Parse(line["data: ".Length..]).RootElement.Clone();
+                events.Add((currentEvent ?? "message", json));
+            }
+        }
+
+        return events;
+    }
+
+    [Fact]
+    public async Task Stream_emits_sources_then_deltas_then_a_terminal_event()
+    {
+        var events = await ReadStreamAsync("What are concrete formwork stripping requirements?");
+
+        Assert.NotEmpty(events);
+        Assert.Equal("sources", events[0].Event);
+        Assert.Equal("done", events[^1].Event);
+        Assert.Contains(events, e => e.Event == "delta");
+
+        var sourcesIndex = events.FindIndex(e => e.Event == "sources");
+        var firstDeltaIndex = events.FindIndex(e => e.Event == "delta");
+        Assert.True(sourcesIndex < firstDeltaIndex, "Sources must arrive before any content delta.");
+    }
+
+    [Fact]
+    public async Task Concatenated_deltas_reconstruct_the_final_answer()
+    {
+        var events = await ReadStreamAsync("What is the OSHA fall protection trigger height?");
+
+        var assembled = string.Concat(events
+            .Where(e => e.Event == "delta")
+            .Select(e => e.Data.GetProperty("delta").GetString()));
+
+        var done = events.Single(e => e.Event == "done").Data;
+        var final = done.GetProperty("response").GetProperty("content").GetString();
+
+        Assert.False(string.IsNullOrWhiteSpace(assembled));
+        Assert.Equal(final, assembled);
+    }
+
+    [Fact]
+    public async Task Every_event_on_a_stream_shares_one_interaction_id()
+    {
+        var events = await ReadStreamAsync("How do I level subcontractor bids?");
+
+        var ids = events
+            .Select(e => e.Data.GetProperty("interactionId").GetGuid())
+            .Distinct()
+            .ToList();
+
+        Assert.Single(ids);
+        Assert.NotEqual(Guid.Empty, ids[0]);
+    }
+
+    [Fact]
+    public async Task Terminal_event_carries_metadata_for_the_feedback_path()
+    {
+        var events = await ReadStreamAsync("What belongs in an RFI?");
+        var done = events.Single(e => e.Event == "done").Data;
+        var response = done.GetProperty("response");
+
+        Assert.True(response.GetProperty("confidenceScore").GetDouble() > 0);
+        Assert.True(response.GetProperty("processingTimeMs").GetInt64() >= 0);
+
+        // The id from the stream must address a real interaction, or feedback cannot be attached.
+        var interactionId = done.GetProperty("interactionId").GetGuid();
+        var feedback = await _client.PostAsJsonAsync($"/api/feedback/{interactionId}", new StarRating { Stars = 5 });
+        Assert.Equal(HttpStatusCode.Accepted, feedback.StatusCode);
+    }
+
+    [Fact]
+    public async Task Empty_query_is_reported_as_a_stream_error_event()
+    {
+        var events = await ReadStreamAsync("   ");
+
+        var error = Assert.Single(events);
+        Assert.Equal("error", error.Event);
+        Assert.Contains("Query is required", error.Data.GetProperty("error").GetString());
+    }
+}
