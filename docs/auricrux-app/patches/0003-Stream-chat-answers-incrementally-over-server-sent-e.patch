+    /// <summary>
+    /// Streams an answer incrementally as the model produces it.
+    ///
+    /// Non-streaming completion makes a deep-mode answer look like a hang for its whole duration,
+    /// which is the most visible behavioural gap against every general-purpose assistant this app
+    /// is measured against. Grounding sources are emitted first so the UI can show provenance
+    /// before the first token, and the corpus fallback streams the same shape when no model is
+    /// reachable, so a client never needs a second code path.
+    /// </summary>
+    public async IAsyncEnumerable<ChatStreamEvent> StreamChatAsync(
+        ChatRequest request,
+        string? model,
+        [EnumeratorCancellation] CancellationToken ct)
+    {
+        var sw = Stopwatch.StartNew();
+        var interactionId = Guid.NewGuid();
+        var sources = SearchInternal(request.Query, request.SearchScope, take: 5);
+
+        yield return ChatStreamEvent.ForSources(interactionId, sources);
+
+        var system = BuildSystemPrompt(request.ThinkingMode, sources);
+        var content = new StringBuilder();
+
+        await foreach (var delta in StreamCompletionAsync(system, request.Query, request.ConversationHistory, model, ct))
+        {
+            content.Append(delta);
+            yield return ChatStreamEvent.ForDelta(interactionId, delta);
+        }
+
+        sw.Stop();
+        var response = new ChatResponse
+        {
+            Content = content.ToString(),
+            Sources = sources,
+            Timestamp = DateTime.UtcNow,
+            ProcessingTimeMs = sw.ElapsedMilliseconds,
+            ConfidenceScore = sources.Count > 0 ? 0.86 : 0.72,
+            InteractionId = interactionId
+        };
+
+        lock (_gate)
+        {
+            _interactions[interactionId] = response;
+            _interactionOrder.Enqueue(interactionId);
+            while (_interactionOrder.Count > MaxRetainedInteractions)
+            {
+                _interactions.Remove(_interactionOrder.Dequeue());
+            }
+        }
+
+        yield return ChatStreamEvent.ForDone(interactionId, response);
+    }
+
+    /// <summary>
+    /// Yields content deltas from Ollama's newline-delimited streaming response, falling back to
+    /// the corpus answer chunked into deltas when the model is unreachable.
+    /// </summary>
+    private async IAsyncEnumerable<string> StreamCompletionAsync(
+        string system,
+        string user,
+        IEnumerable<ChatMessage> history,
+        string? model,
+        [EnumeratorCancellation] CancellationToken ct)
+    {
+        var ollamaBase = (_config["Auricrux:OllamaUrl"] ?? "http://127.0.0.1:11434").TrimEnd('/');
+        var selected = string.IsNullOrWhiteSpace(model)
+            ? (_config["Auricrux:PrimaryModel"] ?? "llama3.2")
+            : model;
+
+        var messages = new List<object> { new { role = "system", content = system } };
+        foreach (var h in history.TakeLast(12))
+        {
+            messages.Add(new { role = h.Role, content = h.Content });
+        }
+        messages.Add(new { role = "user", content = user });
+
+        HttpResponseMessage? response = null;
+        Stream? stream = null;
+        StreamReader? reader = null;
+        try
+        {
+            try
+            {
+                var http = _httpClientFactory.CreateClient(nameof(ConstructionIntelligenceService));
+                using var httpRequest = new HttpRequestMessage(HttpMethod.Post, $"{ollamaBase}/api/chat")
+                {
+                    Content = new StringContent(
+                        JsonSerializer.Serialize(new { model = selected, stream = true, messages }),
+                        Encoding.UTF8,
+                        "application/json")
+                };
+
+                // Headers-read so deltas surface as they arrive rather than after the full body.
+                response = await http.SendAsync(httpRequest, HttpCompletionOption.ResponseHeadersRead, ct);
+                if (!response.IsSuccessStatusCode)
+                {
+                    _logger.LogWarning("Ollama stream {Model} returned {Status}", selected, response.StatusCode);
+                    response.Dispose();
+                    response = null;
+                }
+                else
+                {
+                    stream = await response.Content.ReadAsStreamAsync(ct);
+                    reader = new StreamReader(stream, Encoding.UTF8);
+                }
+            }
+            catch (Exception ex) when (ex is not OperationCanceledException)
+            {
+                _logger.LogWarning(ex, "Ollama stream unavailable; using construction corpus fallback");
+            }
+
+            if (reader is null)
+            {
+                foreach (var chunk in ChunkForStreaming(ConstructionFallback(user)))
+                {
+                    ct.ThrowIfCancellationRequested();
+                    yield return chunk;
+                }
+
+                yield break;
+            }
+
+            while (!reader.EndOfStream)
+            {
+                ct.ThrowIfCancellationRequested();
+
+                var line = await reader.ReadLineAsync(ct);
+                if (string.IsNullOrWhiteSpace(line))
+                {
+                    continue;
+                }
+
+                if (!TryReadDelta(line, out var delta, out var done))
+                {
+                    continue;
+                }
+
+                if (!string.IsNullOrEmpty(delta))
+                {
+                    yield return delta;
+                }
+
+                if (done)
+                {
+                    yield break;
+                }
+            }
+        }
+        finally
+        {
+            reader?.Dispose();
+            stream?.Dispose();
+            response?.Dispose();
+        }
+    }
+
+    private bool TryReadDelta(string line, out string delta, out bool done)
+    {
+        delta = string.Empty;
+        done = false;
+
+        try
+        {
+            using var doc = JsonDocument.Parse(line);
+            if (doc.RootElement.TryGetProperty("message", out var message)
+                && message.TryGetProperty("content", out var contentElement))
+            {
+                delta = contentElement.GetString() ?? string.Empty;
+            }
+
+            done = doc.RootElement.TryGetProperty("done", out var doneElement)
+                   && doneElement.ValueKind == JsonValueKind.True;
+            return true;
+        }
+        catch (JsonException)
+        {
+            _logger.LogDebug("Skipped unparsable Ollama stream line");
+            return false;
+        }
+    }
+
+    // The corpus fallback arrives as one string; chunking it keeps the wire shape identical to a
+    // live model stream so clients do not branch on which path served the answer.
+    private static IEnumerable<string> ChunkForStreaming(string text)
+    {
+        const int chunkSize = 48;
+        for (var i = 0; i < text.Length; i += chunkSize)
+        {
+            yield return text.Substring(i, Math.Min(chunkSize, text.Length - i));
+        }
+    }
+
     public async Task<ThinkingResponse> ThinkAsync(ThinkingRequest request, string? model, CancellationToken ct)
     {
         var sw = Stopwatch.StartNew();
