+using Auricrux.Shared.Models;
+
+namespace Auricrux.Web.Services;
+
+/// <summary>The kind of event carried on a streaming chat response.</summary>
+public enum ChatStreamEventType
+{
+    /// <summary>Grounding sources, sent once before the first content delta.</summary>
+    Sources = 0,
+
+    /// <summary>An incremental piece of the answer.</summary>
+    Delta = 1,
+
+    /// <summary>Terminal event carrying the assembled answer and its metadata.</summary>
+    Done = 2,
+
+    /// <summary>The stream ended early because of a fault.</summary>
+    Error = 3
+}
+
+/// <summary>
+/// One event on a server-sent chat stream. Sources arrive first so a client can render
+/// provenance before any tokens, deltas carry the answer as it is produced, and a single
+/// terminal event carries timings and the interaction id used for feedback.
+/// </summary>
+public sealed class ChatStreamEvent
+{
+    /// <summary>Which kind of event this is.</summary>
+    public required string Type { get; init; }
+
+    /// <summary>Identifier tying every event on this stream to one interaction.</summary>
+    public Guid InteractionId { get; init; }
+
+    /// <summary>Incremental answer text, present on delta events.</summary>
+    public string? Delta { get; init; }
+
+    /// <summary>Grounding sources, present on the sources event.</summary>
+    public List<Source>? Sources { get; init; }
+
+    /// <summary>Assembled response and metadata, present on the terminal event.</summary>
+    public ChatResponse? Response { get; init; }
+
+    /// <summary>Failure description, present on an error event.</summary>
+    public string? Error { get; init; }
+
+    /// <summary>Creates the leading sources event.</summary>
+    public static ChatStreamEvent ForSources(Guid interactionId, List<Source> sources) => new()
+    {
+        Type = "sources",
+        InteractionId = interactionId,
+        Sources = sources
+    };
+
+    /// <summary>Creates an incremental content event.</summary>
+    public static ChatStreamEvent ForDelta(Guid interactionId, string delta) => new()
+    {
+        Type = "delta",
+        InteractionId = interactionId,
+        Delta = delta
+    };
+
+    /// <summary>Creates the terminal event.</summary>
+    public static ChatStreamEvent ForDone(Guid interactionId, ChatResponse response) => new()
+    {
+        Type = "done",
+        InteractionId = interactionId,
+        Response = response
+    };
+
+    /// <summary>Creates an error event for a stream that ended early.</summary>
+    public static ChatStreamEvent ForError(Guid interactionId, string error) => new()
+    {
+        Type = "error",
+        InteractionId = interactionId,
+        Error = error
+    };
+}
