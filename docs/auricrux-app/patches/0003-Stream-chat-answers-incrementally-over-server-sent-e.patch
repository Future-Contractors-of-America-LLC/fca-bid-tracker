+    /// <summary>
+    /// Answers a construction question as a server-sent event stream, emitting grounding sources,
+    /// then incremental content, then a terminal event carrying timings and the interaction id.
+    /// </summary>
+    [HttpPost("chat/stream")]
+    public async Task ChatStream(
+        [FromBody] ChatRequest request,
+        [FromQuery] string? model,
+        CancellationToken cancellationToken)
+    {
+        Response.ContentType = "text/event-stream";
+        Response.Headers.CacheControl = "no-cache";
+        Response.Headers.Connection = "keep-alive";
+        // Proxies that buffer will defeat streaming entirely; this is the conventional opt-out.
+        Response.Headers["X-Accel-Buffering"] = "no";
+
+        if (string.IsNullOrWhiteSpace(request.Query))
+        {
+            await WriteEventAsync(ChatStreamEvent.ForError(Guid.Empty, "Query is required."), cancellationToken);
+            return;
+        }
+
+        var resolved = ResolveModel(model, out var entitlementError);
+        if (entitlementError is not null)
+        {
+            await WriteEventAsync(
+                ChatStreamEvent.ForError(Guid.Empty, DescribeEntitlementError(entitlementError)),
+                cancellationToken);
+            return;
+        }
+
+        logger.LogInformation(
+            "Chat stream mode={Mode} scope={Scope} model={Model}",
+            request.ThinkingMode, request.SearchScope, resolved);
+
+        try
+        {
+            await foreach (var streamEvent in intelligence.StreamChatAsync(request, resolved, cancellationToken))
+            {
+                await WriteEventAsync(streamEvent, cancellationToken);
+            }
+        }
+        catch (OperationCanceledException)
+        {
+            // The client hung up; nothing to report and nothing to log as a fault.
+        }
+        catch (Exception ex)
+        {
+            logger.LogError(ex, "Chat stream failed (correlation={CorrelationId})", HttpContext.TraceIdentifier);
+            await WriteEventAsync(
+                ChatStreamEvent.ForError(Guid.Empty, "The stream ended unexpectedly."),
+                CancellationToken.None);
+        }
+    }
+
+    private async Task WriteEventAsync(ChatStreamEvent streamEvent, CancellationToken ct)
+    {
+        var json = System.Text.Json.JsonSerializer.Serialize(streamEvent, StreamJsonOptions);
+        await Response.WriteAsync($"event: {streamEvent.Type}\ndata: {json}\n\n", ct);
+        await Response.Body.FlushAsync(ct);
+    }
+
+    private static readonly System.Text.Json.JsonSerializerOptions StreamJsonOptions = new(System.Text.Json.JsonSerializerDefaults.Web)
+    {
+        DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull
+    };
+
+    // The stream has already committed a 200 and an SSE content type by the time entitlement is
+    // known, so the refusal has to travel as an error event rather than a status code.
+    private static string DescribeEntitlementError(ActionResult error) => error switch
+    {
+        ObjectResult { StatusCode: StatusCodes.Status402PaymentRequired } => "Daily query limit reached. Upgrade to continue.",
+        ObjectResult { StatusCode: StatusCodes.Status403Forbidden } => "Model not included in current plan.",
+        UnauthorizedObjectResult => "An identified account is required for this deployment.",
+        NotFoundObjectResult => "Account not registered.",
+        _ => "Request refused."
+    };
+
