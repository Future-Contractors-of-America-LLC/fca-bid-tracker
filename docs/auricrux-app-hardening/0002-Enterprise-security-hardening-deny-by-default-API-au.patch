+using Auricrux.Web.Services;
+using Microsoft.Extensions.Configuration;
+using Xunit;
+
+namespace Auricrux.Tests;
+
+/// <summary>
+/// Durability proofs for the stores that previously lived only in process memory:
+/// FCA account links and star-rating feedback must survive a simulated process restart
+/// (a second store instance pointed at the same SQLite file).
+/// </summary>
+public sealed class DurableStoresTests : IDisposable
+{
+    private readonly string _tempDir = Path.Combine(Path.GetTempPath(), $"auricrux-durable-{Guid.NewGuid():N}");
+
+    [Fact]
+    public void Fca_link_persists_across_simulated_process_restart()
+    {
+        var dbPath = Path.Combine(_tempDir, "fca_links.db");
+        var record = new FcaLinkRecord(
+            AuricruxEmail: "linked@test.local",
+            LinkedAtUtc: DateTime.UtcNow,
+            Plan: "academy-pro",
+            HasAcademy: true,
+            HasCte: false,
+            HasEmbeddedAuricrux: true,
+            Status: "active");
+
+        var firstProcess = new FcaAccountLinkService(new StubHttpClientFactory(), EmptyConfig(), dbPath);
+        firstProcess.Save(record);
+
+        var secondProcess = new FcaAccountLinkService(new StubHttpClientFactory(), EmptyConfig(), dbPath);
+        var restored = secondProcess.Get("linked@test.local");
+
+        Assert.NotNull(restored);
+        Assert.Equal("academy-pro", restored!.Plan);
+        Assert.True(restored.HasAcademy);
+        Assert.True(restored.HasEmbeddedAuricrux);
+        Assert.Equal("active", restored.Status);
+    }
+
+    [Fact]
+    public void Fca_unlink_removes_row_durably()
+    {
+        var dbPath = Path.Combine(_tempDir, "fca_links_unlink.db");
+        var record = new FcaLinkRecord("gone@test.local", DateTime.UtcNow, "free", false, false, false, "active");
+
+        var firstProcess = new FcaAccountLinkService(new StubHttpClientFactory(), EmptyConfig(), dbPath);
+        firstProcess.Save(record);
+        Assert.True(firstProcess.Unlink("gone@test.local"));
+
+        var secondProcess = new FcaAccountLinkService(new StubHttpClientFactory(), EmptyConfig(), dbPath);
+        Assert.Null(secondProcess.Get("gone@test.local"));
+    }
+
+    [Fact]
+    public void Feedback_persists_across_simulated_process_restart()
+    {
+        var dbPath = Path.Combine(_tempDir, "feedback.db");
+        var interactionId = Guid.NewGuid();
+
+        var firstProcess = new FeedbackStore(dbPath);
+        firstProcess.Record(interactionId, 4, "solid field answer");
+
+        var secondProcess = new FeedbackStore(dbPath);
+        var restored = secondProcess.Get(interactionId);
+
+        Assert.NotNull(restored);
+        Assert.Equal(4, restored!.Stars);
+        Assert.Equal("solid field answer", restored.Comment);
+    }
+
+    public void Dispose()
+    {
+        if (Directory.Exists(_tempDir))
+        {
+            Directory.Delete(_tempDir, recursive: true);
+        }
+    }
+
+    private static IConfiguration EmptyConfig() => new ConfigurationBuilder().Build();
+
+    private sealed class StubHttpClientFactory : IHttpClientFactory
+    {
+        public HttpClient CreateClient(string name) => new();
+    }
+}
