+using Microsoft.AspNetCore.Authorization;
+
+namespace Auricrux.Web.Middleware;
+
+/// <summary>
+/// Deny-by-default guard for every /api endpoint when Auth:Enabled is true.
+///
+/// Like <c>SecureController</c>, this checks the live <see cref="IConfiguration"/> at request
+/// time (not builder-time locals) so it reflects the actual effective configuration — including
+/// configuration layered on after the app builder ran, as WebApplicationFactory-based
+/// integration tests do. It fails closed: if auth is enabled but no authentication middleware
+/// ever authenticated the request, the request is rejected.
+///
+/// Endpoints marked [AllowAnonymous] (health, models, capabilities, plans) stay public so
+/// uptime probes and pricing surfaces keep working.
+/// </summary>
+public sealed class ApiAuthGuardMiddleware(RequestDelegate next, IConfiguration config)
+{
+    public async Task InvokeAsync(HttpContext context)
+    {
+        if (ShouldDeny(context))
+        {
+            context.Response.StatusCode = StatusCodes.Status401Unauthorized;
+            await context.Response.WriteAsJsonAsync(new { error = "Authentication required." });
+            return;
+        }
+
+        await next(context);
+    }
+
+    private bool ShouldDeny(HttpContext context)
+    {
+        if (!context.Request.Path.StartsWithSegments("/api", StringComparison.OrdinalIgnoreCase))
+        {
+            return false;
+        }
+
+        if (!config.GetValue("Auth:Enabled", false))
+        {
+            return false;
+        }
+
+        var endpoint = context.GetEndpoint();
+        if (endpoint?.Metadata.GetMetadata<IAllowAnonymous>() is not null)
+        {
+            return false;
+        }
+
+        return !(context.User.Identity?.IsAuthenticated ?? false);
+    }
+}
+
+public static class ApiAuthGuardMiddlewareExtensions
+{
+    public static IApplicationBuilder UseApiAuthGuard(this IApplicationBuilder builder)
+        => builder.UseMiddleware<ApiAuthGuardMiddleware>();
+}
