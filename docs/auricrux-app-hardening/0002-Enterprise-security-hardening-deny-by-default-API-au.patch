+using Microsoft.Data.Sqlite;
+
+namespace Auricrux.Web.Services;
+
+/// <summary>
+/// Durable star-rating feedback store (SQLite under Data/memory/feedback.db) so quality
+/// signals survive restarts instead of living only in process logs.
+/// </summary>
+public sealed class FeedbackStore
+{
+    private readonly string _dbPath;
+    private readonly object _gate = new();
+
+    public FeedbackStore(IWebHostEnvironment env)
+        : this(Path.Combine(env.ContentRootPath, "Data", "memory", "feedback.db"))
+    {
+    }
+
+    /// <summary>Testable constructor pointing at an explicit SQLite file path.</summary>
+    public FeedbackStore(string databasePath)
+    {
+        _dbPath = databasePath;
+        Directory.CreateDirectory(Path.GetDirectoryName(_dbPath)!);
+        EnsureSchema();
+    }
+
+    public void Record(Guid interactionId, int stars, string? comment)
+    {
+        lock (_gate)
+        {
+            using var conn = new SqliteConnection($"Data Source={_dbPath}");
+            conn.Open();
+            using var cmd = conn.CreateCommand();
+            cmd.CommandText = """
+                INSERT INTO feedback(interaction_id, stars, comment, created_utc)
+                VALUES ($id, $stars, $comment, $created)
+                ON CONFLICT(interaction_id) DO UPDATE SET
+                    stars = excluded.stars,
+                    comment = excluded.comment,
+                    created_utc = excluded.created_utc
+                """;
+            cmd.Parameters.AddWithValue("$id", interactionId.ToString("D"));
+            cmd.Parameters.AddWithValue("$stars", stars);
+            cmd.Parameters.AddWithValue("$comment", (object?)comment ?? DBNull.Value);
+            cmd.Parameters.AddWithValue("$created", DateTime.UtcNow.ToString("O"));
+            cmd.ExecuteNonQuery();
+        }
+    }
+
+    public FeedbackRecord? Get(Guid interactionId)
+    {
+        lock (_gate)
+        {
+            using var conn = new SqliteConnection($"Data Source={_dbPath}");
+            conn.Open();
+            using var cmd = conn.CreateCommand();
+            cmd.CommandText = "SELECT interaction_id, stars, comment, created_utc FROM feedback WHERE interaction_id = $id";
+            cmd.Parameters.AddWithValue("$id", interactionId.ToString("D"));
+            using var reader = cmd.ExecuteReader();
+            if (!reader.Read())
+            {
+                return null;
+            }
+
+            return new FeedbackRecord(
+                Guid.Parse(reader.GetString(0)),
+                reader.GetInt32(1),
+                reader.IsDBNull(2) ? null : reader.GetString(2),
+                DateTime.Parse(reader.GetString(3), null, System.Globalization.DateTimeStyles.RoundtripKind));
+        }
+    }
+
+    private void EnsureSchema()
+    {
+        using var conn = new SqliteConnection($"Data Source={_dbPath}");
+        conn.Open();
+        using var cmd = conn.CreateCommand();
+        cmd.CommandText = """
+            CREATE TABLE IF NOT EXISTS feedback (
+              interaction_id TEXT PRIMARY KEY,
+              stars INTEGER NOT NULL,
+              comment TEXT NULL,
+              created_utc TEXT NOT NULL
+            );
+            """;
+        cmd.ExecuteNonQuery();
+    }
+}
+
+/// <summary>Persisted feedback row.</summary>
+public sealed record FeedbackRecord(Guid InteractionId, int Stars, string? Comment, DateTime CreatedUtc);
