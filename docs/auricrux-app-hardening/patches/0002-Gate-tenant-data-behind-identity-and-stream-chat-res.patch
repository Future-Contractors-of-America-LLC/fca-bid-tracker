diff --git a/Auricrux.Web/Security/AuricruxSecurityOptions.cs b/Auricrux.Web/Security/AuricruxSecurityOptions.cs
new file mode 100644
index 0000000..3e88334
--- /dev/null
+++ b/Auricrux.Web/Security/AuricruxSecurityOptions.cs
@@ -0,0 +1,125 @@
+namespace Auricrux.Web.Security;
+
+/// <summary>
+/// Effective security posture for the running host, resolved once at startup.
+/// </summary>
+/// <remarks>
+/// The single most important value here is <see cref="OpenMode"/>. Auricrux historically served
+/// every API anonymously, which is convenient for local development but means account, memory,
+/// and workspace data belong to whoever asks for them. Open mode preserves that behaviour for
+/// local development and the test host, and is off by default anywhere that looks like a real
+/// deployment.
+/// </remarks>
+public sealed class AuricruxSecurityOptions
+{
+    /// <summary>Whether the host runs in the Production environment.</summary>
+    public required bool IsProduction { get; init; }
+
+    /// <summary>Whether an authentication scheme is configured and enabled.</summary>
+    public required bool AuthEnabled { get; init; }
+
+    /// <summary>
+    /// When true, unauthenticated callers share a single public tenant and administrative
+    /// operations are unguarded. Intended for local development and integration tests only.
+    /// </summary>
+    public required bool OpenMode { get; init; }
+
+    /// <summary>
+    /// When true, the deployment is in Production without authentication and without an explicit
+    /// opt-in, so data-bearing endpoints are refused rather than served anonymously.
+    /// </summary>
+    public required bool ProductionLockdown { get; init; }
+
+    /// <summary>
+    /// Whether stateless inference (chat, thinking, search, calc, vision, browse) also requires an
+    /// authenticated caller. Off by default: locking tenant data is a security fix, whereas
+    /// locking inference changes who the product is for, which is a deployment decision.
+    /// </summary>
+    public required bool RequireAuthForInference { get; init; }
+
+    /// <summary>Shared secret accepted in <c>X-Auricrux-Admin-Key</c> for administrative calls.</summary>
+    public required string? AdminApiKey { get; init; }
+
+    /// <summary>Role claim value that grants administrative access.</summary>
+    public required string AdminRole { get; init; }
+
+    /// <summary>Email addresses granted administrative access when authenticated.</summary>
+    public required IReadOnlySet<string> AdminEmails { get; init; }
+
+    /// <summary>Maximum accepted length of a single user prompt, in characters.</summary>
+    public required int MaxPromptChars { get; init; }
+
+    /// <summary>Maximum accepted conversation-history turns forwarded to the model.</summary>
+    public required int MaxHistoryTurns { get; init; }
+
+    /// <summary>Maximum accepted workspace upload size, in bytes.</summary>
+    public required long MaxUploadBytes { get; init; }
+
+    /// <summary>File extensions accepted by the workspace uploader.</summary>
+    public required IReadOnlySet<string> AllowedUploadExtensions { get; init; }
+
+    /// <summary>Content-Security-Policy applied to responses.</summary>
+    public required string ContentSecurityPolicy { get; init; }
+
+    /// <summary>
+    /// Resolves the effective posture from configuration. Explicit <c>Security:OpenMode</c> wins;
+    /// otherwise open mode is inferred as "not production and no authentication configured".
+    /// </summary>
+    public static AuricruxSecurityOptions Resolve(IConfiguration config, IHostEnvironment env)
+    {
+        var isProduction = env.IsProduction();
+        var authEnabled = config.GetValue("Auth:Enabled", false)
+                          && !string.IsNullOrWhiteSpace(config["Auth:Authority"]);
+        var allowInsecureProduction = config.GetValue("Security:AllowInsecureProduction", false);
+
+        var explicitOpenMode = config.GetValue<bool?>("Security:OpenMode");
+        var openMode = explicitOpenMode ?? (!isProduction && !authEnabled);
+        if (isProduction && !allowInsecureProduction)
+        {
+            openMode = false;
+        }
+
+        var productionLockdown = isProduction && !authEnabled && !allowInsecureProduction;
+
+        return new AuricruxSecurityOptions
+        {
+            IsProduction = isProduction,
+            AuthEnabled = authEnabled,
+            OpenMode = openMode,
+            ProductionLockdown = productionLockdown,
+            RequireAuthForInference = config.GetValue("Security:RequireAuthForInference", false),
+            AdminApiKey = config["Security:AdminApiKey"],
+            AdminRole = config["Security:AdminRole"] ?? "auricrux-admin",
+            AdminEmails = new HashSet<string>(
+                config.GetSection("Security:AdminEmails").Get<string[]>() ?? [],
+                StringComparer.OrdinalIgnoreCase),
+            MaxPromptChars = config.GetValue("Security:MaxPromptChars", 32_000),
+            MaxHistoryTurns = config.GetValue("Security:MaxHistoryTurns", 40),
+            MaxUploadBytes = config.GetValue("Security:MaxUploadBytes", 26_214_400L),
+            AllowedUploadExtensions = new HashSet<string>(
+                config.GetSection("Security:AllowedUploadExtensions").Get<string[]>()
+                ??
+                [
+                    ".pdf", ".png", ".jpg", ".jpeg", ".gif", ".webp", ".txt", ".md", ".csv",
+                    ".json", ".xml", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx",
+                    ".dwg", ".dxf", ".rvt", ".ifc", ".zip", ".mp4"
+                ],
+                StringComparer.OrdinalIgnoreCase),
+            ContentSecurityPolicy = config["Security:ContentSecurityPolicy"] ?? DefaultCsp
+        };
+    }
+
+    // Blazor Server streams rendered markup over SignalR and does not need 'unsafe-eval'; inline
+    // script remains permitted because the framework emits an inline bootstrap script.
+    private const string DefaultCsp =
+        "default-src 'self'; " +
+        "script-src 'self' 'unsafe-inline'; " +
+        "style-src 'self' 'unsafe-inline'; " +
+        "img-src 'self' data: blob:; " +
+        "font-src 'self' data:; " +
+        "connect-src 'self' ws: wss:; " +
+        "object-src 'none'; " +
+        "base-uri 'self'; " +
+        "form-action 'self'; " +
+        "frame-ancestors 'none'";
+}
diff --git a/Auricrux.Web/Security/CallerContext.cs b/Auricrux.Web/Security/CallerContext.cs
new file mode 100644
index 0000000..a84b11a
--- /dev/null
+++ b/Auricrux.Web/Security/CallerContext.cs
@@ -0,0 +1,133 @@
+using System.Security.Claims;
+using System.Security.Cryptography;
+using System.Text;
+
+namespace Auricrux.Web.Security;
+
+/// <summary>
+/// The identity Auricrux attributes a request to, and the tenant whose data it may touch.
+/// </summary>
+/// <param name="TenantKey">
+/// Storage partition for this caller. <c>"public"</c> is the shared partition used in open mode.
+/// </param>
+/// <param name="Email">Caller email when known, used for freemium entitlement lookup.</param>
+/// <param name="IsAuthenticated">Whether the identity was proven by a validated token or cookie.</param>
+/// <param name="IsAdmin">Whether the caller may perform administrative operations.</param>
+/// <param name="Source">How the identity was established, for audit logging.</param>
+public sealed record CallerContext(
+    string TenantKey,
+    string? Email,
+    bool IsAuthenticated,
+    bool IsAdmin,
+    string Source)
+{
+    /// <summary>The shared partition used when every caller is treated as the same tenant.</summary>
+    public const string PublicTenant = "public";
+
+    /// <summary>Whether this caller may read and write tenant-scoped data at all.</summary>
+    public bool CanAccessTenantData => TenantKey.Length > 0;
+
+    /// <summary>A caller that has proven nothing and may not touch tenant data.</summary>
+    public static CallerContext Denied { get; } = new("", null, false, false, "anonymous");
+}
+
+/// <summary>
+/// Resolves the <see cref="CallerContext"/> for the current request.
+/// </summary>
+public sealed class CallerContextResolver(
+    IHttpContextAccessor httpContextAccessor,
+    AuricruxSecurityOptions security)
+{
+    /// <summary>Header carrying an unverified caller email, honoured only in open mode.</summary>
+    public const string EmailHeader = "X-Auricrux-Email";
+
+    /// <summary>Header carrying the administrative shared secret.</summary>
+    public const string AdminKeyHeader = "X-Auricrux-Admin-Key";
+
+    /// <summary>
+    /// Determines who is calling. An authenticated principal always wins; the unverified email
+    /// header is honoured only in open mode, because anyone can send it.
+    /// </summary>
+    public CallerContext Resolve()
+    {
+        var http = httpContextAccessor.HttpContext;
+        if (http is null)
+        {
+            return security.OpenMode
+                ? new CallerContext(CallerContext.PublicTenant, null, false, security.OpenMode, "open-mode")
+                : CallerContext.Denied;
+        }
+
+        var user = http.User;
+        if (user.Identity?.IsAuthenticated == true)
+        {
+            var subject = FirstClaim(user, "sub", ClaimTypes.NameIdentifier, "oid")
+                          ?? user.Identity.Name
+                          ?? "unknown";
+            var email = FirstClaim(user, "email", ClaimTypes.Email, "preferred_username", "upn");
+            return new CallerContext(
+                TenantKey: TenantKeyFor(subject),
+                Email: email?.Trim().ToLowerInvariant(),
+                IsAuthenticated: true,
+                IsAdmin: IsAdminPrincipal(user, email) || HasValidAdminKey(http),
+                Source: "token");
+        }
+
+        if (HasValidAdminKey(http))
+        {
+            return new CallerContext(CallerContext.PublicTenant, null, false, true, "admin-key");
+        }
+
+        if (security.OpenMode)
+        {
+            // Open mode keeps the historical single-tenant behaviour: an unverified header still
+            // selects a freemium account, but every caller shares one storage partition.
+            var headerEmail = http.Request.Headers[EmailHeader].ToString();
+            return new CallerContext(
+                TenantKey: CallerContext.PublicTenant,
+                Email: string.IsNullOrWhiteSpace(headerEmail) ? null : headerEmail.Trim().ToLowerInvariant(),
+                IsAuthenticated: false,
+                IsAdmin: true,
+                Source: string.IsNullOrWhiteSpace(headerEmail) ? "open-mode" : "open-mode-header");
+        }
+
+        return CallerContext.Denied;
+    }
+
+    private bool IsAdminPrincipal(ClaimsPrincipal user, string? email)
+        => user.IsInRole(security.AdminRole)
+           || user.HasClaim("roles", security.AdminRole)
+           || user.HasClaim("role", security.AdminRole)
+           || (email is not null && security.AdminEmails.Contains(email));
+
+    private bool HasValidAdminKey(HttpContext http)
+    {
+        if (string.IsNullOrWhiteSpace(security.AdminApiKey))
+        {
+            return false;
+        }
+
+        var presented = http.Request.Headers[AdminKeyHeader].ToString();
+        if (string.IsNullOrEmpty(presented))
+        {
+            return false;
+        }
+
+        return CryptographicOperations.FixedTimeEquals(
+            Encoding.UTF8.GetBytes(presented),
+            Encoding.UTF8.GetBytes(security.AdminApiKey));
+    }
+
+    private static string? FirstClaim(ClaimsPrincipal user, params string[] types)
+        => types.Select(user.FindFirst).FirstOrDefault(c => !string.IsNullOrWhiteSpace(c?.Value))?.Value;
+
+    /// <summary>
+    /// Derives a stable, opaque storage partition name from an identity subject. Hashing keeps
+    /// raw subjects and email addresses out of file paths and database keys.
+    /// </summary>
+    public static string TenantKeyFor(string subject)
+    {
+        var hash = SHA256.HashData(Encoding.UTF8.GetBytes(subject.Trim().ToLowerInvariant()));
+        return Convert.ToHexStringLower(hash)[..32];
+    }
+}
diff --git a/Auricrux.Web/Security/TenantGuard.cs b/Auricrux.Web/Security/TenantGuard.cs
new file mode 100644
index 0000000..8179911
--- /dev/null
+++ b/Auricrux.Web/Security/TenantGuard.cs
@@ -0,0 +1,79 @@
+using Microsoft.AspNetCore.Mvc;
+
+namespace Auricrux.Web.Security;
+
+/// <summary>
+/// Shared entry point for endpoints that read or write caller-owned data.
+/// </summary>
+public sealed class TenantGuard(CallerContextResolver resolver, AuricruxSecurityOptions security)
+{
+    /// <summary>The security posture the host resolved at startup.</summary>
+    public AuricruxSecurityOptions Security => security;
+
+    /// <summary>
+    /// Resolves the caller and, when the caller may not touch tenant data, produces the response
+    /// to return instead.
+    /// </summary>
+    public bool TryAuthorize(out CallerContext caller, out ActionResult? denial)
+    {
+        caller = resolver.Resolve();
+        if (caller.CanAccessTenantData)
+        {
+            denial = null;
+            return true;
+        }
+
+        denial = Denial();
+        return false;
+    }
+
+    /// <summary>
+    /// Resolves the caller and, when the caller is not an administrator, produces the response to
+    /// return instead.
+    /// </summary>
+    public bool TryAuthorizeAdmin(out CallerContext caller, out ActionResult? denial)
+    {
+        caller = resolver.Resolve();
+        if (caller.IsAdmin)
+        {
+            denial = null;
+            return true;
+        }
+
+        denial = new ObjectResult(new
+        {
+            error = "Administrative privileges are required for this operation.",
+            remediation = $"Send a valid {CallerContextResolver.AdminKeyHeader} header, or authenticate as a "
+                          + $"principal holding the '{security.AdminRole}' role."
+        })
+        {
+            StatusCode = StatusCodes.Status403Forbidden
+        };
+        return false;
+    }
+
+    private ObjectResult Denial()
+    {
+        // A locked-down production host has no authentication configured at all, so a 401 would
+        // invite the caller to retry with a token that can never be issued. Say what is actually
+        // wrong instead.
+        if (security.ProductionLockdown)
+        {
+            return new ObjectResult(new
+            {
+                error = "This deployment is running in Production without authentication, so "
+                        + "account, memory, and workspace endpoints are disabled.",
+                remediation = "Configure Auth:Enabled and Auth:Authority, or set "
+                              + "Security:AllowInsecureProduction=true to knowingly serve them anonymously."
+            })
+            {
+                StatusCode = StatusCodes.Status403Forbidden
+            };
+        }
+
+        return new ObjectResult(new { error = "Authentication is required for this operation." })
+        {
+            StatusCode = StatusCodes.Status401Unauthorized
+        };
+    }
+}
