+    /// <summary>
+    /// Streams a grounded answer token-by-token. Emits a <c>sources</c> event first so the client
+    /// can render citations immediately, then <c>token</c> events, then a terminal <c>done</c>.
+    /// </summary>
+    public async IAsyncEnumerable<StreamChunk> StreamChatAsync(
+        ChatRequest request,
+        string? model,
+        [EnumeratorCancellation] CancellationToken ct)
+    {
+        var sw = Stopwatch.StartNew();
+        var sources = SearchInternal(request.Query, request.SearchScope, take: 5);
+        var interactionId = Guid.NewGuid();
+
+        yield return new StreamChunk("sources", new { interactionId, sources });
+
+        var system = BuildSystemPrompt(request.ThinkingMode, sources);
+        var builder = new System.Text.StringBuilder();
+
+        await foreach (var token in StreamCompletionAsync(system, request.Query, request.ConversationHistory, model, ct))
+        {
+            builder.Append(token);
+            yield return new StreamChunk("token", new { text = token });
+        }
+
+        sw.Stop();
+        var content = builder.ToString();
+        if (string.IsNullOrWhiteSpace(content))
+        {
+            content = ConstructionFallback(request.Query);
+            yield return new StreamChunk("token", new { text = content });
+        }
+
+        var response = new ChatResponse
+        {
+            Content = content,
+            Sources = sources,
+            Timestamp = DateTime.UtcNow,
+            ProcessingTimeMs = sw.ElapsedMilliseconds,
+            ConfidenceScore = sources.Count > 0 ? 0.86 : 0.72,
+            InteractionId = interactionId
+        };
+
+        lock (_gate)
+        {
+            _interactions[interactionId] = response;
+        }
+
+        yield return new StreamChunk("done", new
+        {
+            interactionId,
+            processingTimeMs = response.ProcessingTimeMs,
+            confidenceScore = response.ConfidenceScore
