+    /// chunk when no local model is reachable, so the stream contract holds either way.
+    /// </summary>
+    private async IAsyncEnumerable<string> StreamCompletionAsync(
+        string system,
+        string user,
+        IEnumerable<ChatMessage> history,
+        string? model,
+        [EnumeratorCancellation] CancellationToken ct)
+    {
+        var ollamaBase = (_config["Auricrux:OllamaUrl"] ?? "http://127.0.0.1:11434").TrimEnd('/');
