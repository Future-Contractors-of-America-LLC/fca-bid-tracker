+    /// <summary>
+    /// Streams a chat answer as Server-Sent Events so clients can render tokens as they arrive,
+    /// matching the incremental output every major assistant provides.
+    /// </summary>
+    [HttpPost("chat/stream")]
+    public async Task StreamChat(
+        [FromBody] ChatRequest request,
+        [FromQuery] string? model,
+        CancellationToken cancellationToken)
+    {
+        Response.ContentType = "text/event-stream";
+        Response.Headers.CacheControl = "no-store";
+        Response.Headers["X-Accel-Buffering"] = "no";
+
+        if (string.IsNullOrWhiteSpace(request.Query))
+        {
+            await WriteEventAsync("error", new { error = "Query is required." }, cancellationToken);
+            return;
+        }
+
+        if (request.Query.Length > security.MaxPromptChars)
+        {
+            await WriteEventAsync("error", new { error = $"Query exceeds the {security.MaxPromptChars} character limit." }, cancellationToken);
+            return;
+        }
+
+        TrimHistory(request);
+
+        var resolved = ResolveModel(model, out var entitlementError);
+        if (entitlementError is not null)
+        {
+            await WriteEventAsync("error", new { error = "Model or quota not available on the current plan." }, cancellationToken);
+            return;
+        }
+
+        try
+        {
+            await foreach (var chunk in intelligence.StreamChatAsync(request, resolved, cancellationToken))
+            {
+                await WriteEventAsync(chunk.Event, chunk.Payload, cancellationToken);
+            }
+        }
+        catch (OperationCanceledException)
+        {
+            // Client navigated away or pressed stop; nothing further to send.
+        }
+        catch (Exception ex)
+        {
+            logger.LogError(ex, "Streaming chat failed (correlation={CorrelationId})", HttpContext.TraceIdentifier);
+            await WriteEventAsync("error", new { error = "Generation failed.", correlationId = HttpContext.TraceIdentifier }, CancellationToken.None);
+        }
+    }
+
+    private async Task WriteEventAsync(string eventName, object payload, CancellationToken ct)
+    {
+        var json = System.Text.Json.JsonSerializer.Serialize(payload, StreamJsonOptions);
+        await Response.WriteAsync($"event: {eventName}\ndata: {json}\n\n", ct);
+        await Response.Body.FlushAsync(ct);
+    }
+
+    private static readonly System.Text.Json.JsonSerializerOptions StreamJsonOptions = new()
+    {
+        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
+    };
+
