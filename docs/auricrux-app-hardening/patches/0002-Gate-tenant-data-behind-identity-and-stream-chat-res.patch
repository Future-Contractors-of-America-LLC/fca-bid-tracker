+    /// <summary>
+    /// Rejects an empty or oversized prompt. Returns <see langword="true"/> when the request
+    /// should not proceed.
+    /// </summary>
+    private bool ValidatePrompt(string? query, out ActionResult? error)
     {
+        if (string.IsNullOrWhiteSpace(query))
+        {
+            error = BadRequest(new { error = "Query is required." });
+            return true;
+        }
+
+        if (query.Length > security.MaxPromptChars)
+        {
+            error = BadRequest(new { error = $"Query exceeds the {security.MaxPromptChars} character limit." });
+            return true;
+        }
+
         error = null;
+        return false;
+    }
+
+    /// <summary>
+    /// Caps forwarded history so a caller cannot drive unbounded upstream token cost with one
+    /// request.
+    /// </summary>
+    private void TrimHistory(ChatRequest request)
+    {
+        if (request.ConversationHistory.Count > security.MaxHistoryTurns)
+        {
+            request.ConversationHistory = request.ConversationHistory
+                .TakeLast(security.MaxHistoryTurns)
+                .ToList();
+        }
+    }
+
+    /// <summary>
+    /// Applies plan entitlements to the requested model. The account is taken from the resolved
+    /// caller rather than a request header, so a client cannot skip metering by omitting it or
+    /// borrow another account's plan by forging it.
+    /// </summary>
+    private string? ResolveModel(string? model, out ActionResult? error)
+    {
+        error = null;
+        var caller = callerResolver.Resolve();
+        var accountEmail = caller.Email;
+
         if (string.IsNullOrWhiteSpace(accountEmail))
         {
+            // Inference stays open unless an operator explicitly closes it. Locking tenant data is
+            // a security fix; locking inference changes who may use the product at all.
+            if (security.RequireAuthForInference && !caller.IsAuthenticated)
+            {
+                error = StatusCode(StatusCodes.Status401Unauthorized, new
+                {
+                    error = "Authentication is required to run inference on this deployment."
+                });
+                return null;
+            }
+
             return model;
         }
 
