+++ b/Auricrux.Web/Services/SsrfGuard.cs
@@ -0,0 +1,170 @@
+using System.Net;
+using System.Net.Sockets;
+
+namespace Auricrux.Web.Services;
+
+/// <summary>
+/// Decides whether an outbound URL is safe to fetch on behalf of a caller.
+/// </summary>
+/// <remarks>
+/// Host-name blocklists are not sufficient: any attacker-controlled DNS name can resolve to a
+/// private address (for example <c>127.0.0.1.nip.io</c>), and a public host can redirect to one.
+/// This guard therefore resolves the host and rejects the request unless <em>every</em> resolved
+/// address is publicly routable, and callers re-validate each redirect hop.
+/// </remarks>
+public sealed class SsrfGuard(IConfiguration config, ILogger<SsrfGuard> logger)
+{
+    private static readonly string[] AlwaysBlockedSuffixes = [".local", ".internal", ".localdomain"];
+
+    private static readonly string[] AlwaysBlockedHosts =
+    [
+        "localhost",
+        "metadata",
+        "metadata.google.internal",
+        "instance-data",
+        "metadata.azure.com"
+    ];
+
+    /// <summary>
+    /// Hosts an operator has explicitly allowed even though they resolve privately. Intended for
+    /// self-hosted intranet documentation sources, and empty by default.
+    /// </summary>
+    private string[] AllowedPrivateHosts =>
+        config.GetSection("Security:Browse:AllowedPrivateHosts").Get<string[]>() ?? [];
+
+    /// <summary>
+    /// Validates a URL and returns the reason it was rejected, or <see langword="null"/> when the
+    /// URL is safe to fetch.
+    /// </summary>
+    public async Task<string?> GetRejectionReasonAsync(Uri uri, CancellationToken ct)
+    {
+        if (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps)
+        {
+            return "Only absolute http/https URLs are allowed.";
+        }
+
+        var host = uri.Host.Trim().TrimEnd('.').ToLowerInvariant();
+        if (string.IsNullOrWhiteSpace(host))
+        {
+            return "That host is blocked for SSRF safety.";
+        }
+
+        if (AllowedPrivateHosts.Any(h => h.Equals(host, StringComparison.OrdinalIgnoreCase)))
+        {
+            return null;
+        }
+
+        if (AlwaysBlockedHosts.Contains(host)
+            || AlwaysBlockedSuffixes.Any(s => host.EndsWith(s, StringComparison.Ordinal)))
+        {
+            return "That host is blocked for SSRF safety.";
+        }
+
+        IPAddress[] addresses;
+        if (IPAddress.TryParse(host.Trim('[', ']'), out var literal))
+        {
+            addresses = [literal];
+        }
+        else
+        {
+            try
+            {
+                addresses = await Dns.GetHostAddressesAsync(host, ct);
+            }
+            catch (Exception ex)
+            {
+                logger.LogInformation(ex, "SSRF guard could not resolve {Host}", host);
+                return "That host could not be resolved.";
+            }
+        }
+
+        if (addresses.Length == 0)
+        {
+            return "That host could not be resolved.";
+        }
+
+        // Reject if ANY resolved address is private: a hostile resolver can otherwise return one
+        // public and one private address and win the race between validation and connection.
+        foreach (var address in addresses)
+        {
+            if (!IsPubliclyRoutable(address))
+            {
+                logger.LogWarning("SSRF guard blocked {Host} resolving to non-public {Address}", host, address);
+                return "That host resolves to a non-public address and is blocked for SSRF safety.";
+            }
+        }
+
+        return null;
+    }
+
+    /// <summary>
+    /// Returns whether an IP address is a public, externally routable unicast address.
+    /// </summary>
+    public static bool IsPubliclyRoutable(IPAddress address)
+    {
+        if (IPAddress.IsLoopback(address) || IPAddress.Any.Equals(address) || IPAddress.IPv6Any.Equals(address))
+        {
+            return false;
+        }
+
+        if (address.IsIPv4MappedToIPv6)
+        {
+            return IsPubliclyRoutable(address.MapToIPv4());
+        }
+
+        return address.AddressFamily switch
+        {
+            AddressFamily.InterNetwork => IsPublicIPv4(address.GetAddressBytes()),
+            AddressFamily.InterNetworkV6 => IsPublicIPv6(address),
+            _ => false
+        };
+    }
+
+    private static bool IsPublicIPv4(byte[] b)
+    {
+        if (b.Length != 4) return false;
+
+        return b[0] switch
+        {
+            0 => false,                                     // 0.0.0.0/8 "this network"
+            10 => false,                                    // RFC1918 private
+            127 => false,                                   // loopback
+            100 when b[1] >= 64 && b[1] <= 127 => false,    // RFC6598 carrier-grade NAT
+            169 when b[1] == 254 => false,                  // link-local / cloud metadata
+            172 when b[1] >= 16 && b[1] <= 31 => false,     // RFC1918 private
+            192 when b[1] == 0 && b[2] == 0 => false,       // IETF protocol assignments
+            192 when b[1] == 0 && b[2] == 2 => false,       // TEST-NET-1
+            192 when b[1] == 168 => false,                  // RFC1918 private
+            198 when b[1] == 18 || b[1] == 19 => false,     // benchmarking
+            198 when b[1] == 51 && b[2] == 100 => false,    // TEST-NET-2
+            203 when b[1] == 0 && b[2] == 113 => false,     // TEST-NET-3
+            >= 224 => false,                                // multicast, reserved, broadcast
+            _ => true
+        };
+    }
+
+    private static bool IsPublicIPv6(IPAddress address)
+    {
+        if (address.IsIPv6LinkLocal || address.IsIPv6SiteLocal || address.IsIPv6Multicast
+            || address.IsIPv6UniqueLocal || address.IsIPv6Teredo)
+        {
+            return false;
+        }
+
+        var b = address.GetAddressBytes();
+
+        // ::/128 unspecified and ::1/128 loopback are covered above; also reject the
+        // IPv4-compatible ::a.b.c.d range and the NAT64 well-known prefix 64:ff9b::/96.
+        if (b.Take(12).All(x => x == 0))
+        {
+            return false;
+        }
+
+        if (b[0] == 0x00 && b[1] == 0x64 && b[2] == 0xff && b[3] == 0x9b)
+        {
+            return false;
+        }
+
+        return true;
+    }
+}
