+    /// <summary>
+    /// Performs the fetch with automatic redirects disabled, re-running the SSRF guard against
+    /// every hop. Returns <see langword="null"/> when a hop points at a non-public address.
+    /// </summary>
+    private async Task<HttpResponseMessage?> GetFollowingValidatedRedirectsAsync(
+        HttpClient http,
+        Uri uri,
+        CancellationToken ct)
+    {
+        var current = uri;
+        for (var hop = 0; hop <= MaxRedirects; hop++)
+        {
+            using var message = new HttpRequestMessage(HttpMethod.Get, current);
+            var response = await http.SendAsync(message, HttpCompletionOption.ResponseHeadersRead, ct);
+
+            if (!IsRedirect(response.StatusCode) || response.Headers.Location is null)
+            {
+                return response;
+            }
+
+            var next = response.Headers.Location.IsAbsoluteUri
+                ? response.Headers.Location
+                : new Uri(current, response.Headers.Location);
+            response.Dispose();
+
+            var rejection = await ssrfGuard.GetRejectionReasonAsync(next, ct);
+            if (rejection is not null)
+            {
+                logger.LogWarning("Blocked redirect from {From} to {To}: {Reason}", current, next, rejection);
+                return null;
+            }
+
+            current = next;
+        }
+
+        logger.LogWarning("Web browse exceeded {MaxRedirects} redirects starting at {Url}", MaxRedirects, uri);
+        return null;
+    }
+
+    private static bool IsRedirect(System.Net.HttpStatusCode status) => (int)status is 301 or 302 or 303 or 307 or 308;
+
