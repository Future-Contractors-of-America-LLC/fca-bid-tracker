+using System.Net;
+using Auricrux.Web.Services;
+using Xunit;
+
+namespace Auricrux.Tests;
+
+/// <summary>
+/// Address classification behind the web-browse SSRF guard. The original guard string-matched
+/// hostnames, so any DNS name pointing at a private address reached internal services; these
+/// cases pin the ranges that must never be considered publicly routable.
+/// </summary>
+public sealed class SsrfGuardTests
+{
+    [Theory]
+    [InlineData("127.0.0.1")]          // loopback
+    [InlineData("127.1.2.3")]          // rest of 127/8
+    [InlineData("0.0.0.0")]            // unspecified
+    [InlineData("10.0.0.1")]           // RFC1918
+    [InlineData("172.16.0.1")]         // RFC1918 lower bound
+    [InlineData("172.31.255.254")]     // RFC1918 upper bound
+    [InlineData("192.168.1.1")]        // RFC1918
+    [InlineData("169.254.169.254")]    // cloud instance metadata
+    [InlineData("100.64.0.1")]         // RFC6598 carrier-grade NAT
+    [InlineData("198.18.0.1")]         // benchmarking
+    [InlineData("224.0.0.1")]          // multicast
+    [InlineData("255.255.255.255")]    // broadcast
+    [InlineData("::1")]                // IPv6 loopback
+    [InlineData("fe80::1")]            // IPv6 link-local
+    [InlineData("fc00::1")]            // IPv6 unique local
+    [InlineData("fd12:3456::1")]       // IPv6 unique local
+    [InlineData("::ffff:127.0.0.1")]   // IPv4-mapped loopback
+    [InlineData("::ffff:10.0.0.1")]    // IPv4-mapped RFC1918
+    [InlineData("64:ff9b::7f00:1")]    // NAT64 well-known prefix
+    public void Private_and_reserved_addresses_are_not_publicly_routable(string address)
+    {
+        Assert.False(SsrfGuard.IsPubliclyRoutable(IPAddress.Parse(address)));
+    }
+
+    [Theory]
+    [InlineData("93.184.216.34")]      // example.com
+    [InlineData("8.8.8.8")]
+    [InlineData("1.1.1.1")]
+    [InlineData("172.15.0.1")]         // just below RFC1918 172.16/12
+    [InlineData("172.32.0.1")]         // just above RFC1918 172.16/12
+    [InlineData("100.63.255.255")]     // just below CGNAT 100.64/10
+    [InlineData("100.128.0.1")]        // just above CGNAT 100.64/10
+    [InlineData("2606:4700:4700::1111")]
+    public void Public_addresses_are_routable(string address)
+    {
+        Assert.True(SsrfGuard.IsPubliclyRoutable(IPAddress.Parse(address)));
+    }
+}
