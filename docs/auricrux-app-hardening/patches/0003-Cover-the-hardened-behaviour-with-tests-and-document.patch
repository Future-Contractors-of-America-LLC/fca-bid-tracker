+using System.Net;
+using System.Net.Http.Json;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.Hosting;
+using Xunit;
+
+namespace Auricrux.Tests;
+
+/// <summary>
+/// A host configured the way the shipped container runs it: Production, with no identity provider
+/// configured. Data-bearing endpoints must refuse rather than serve anonymously, while liveness
+/// probes and stateless inference keep working.
+/// </summary>
+public sealed class ProductionHostFactory : WebApplicationFactory<Program>
+{
+    protected override void ConfigureWebHost(IWebHostBuilder builder)
+    {
+        builder.UseEnvironment(Environments.Production);
+        builder.ConfigureAppConfiguration((_, config) =>
+            config.AddInMemoryCollection(new Dictionary<string, string?>
+            {
+                ["Security:AdminApiKey"] = AdminKey
+            }));
+    }
+
+    /// <summary>Admin secret this host accepts, used to prove the administrative path still works.</summary>
+    public const string AdminKey = "test-admin-key-for-production-host";
+}
+
+public sealed class ProductionLockdownTests(ProductionHostFactory factory)
+    : IClassFixture<ProductionHostFactory>
+{
+    private readonly HttpClient _client = factory.CreateClient();
+
+    // ---------- Endpoints that must stay available ----------
+
+    [Theory]
+    [InlineData("/api/health")]
+    [InlineData("/healthz")]
+    [InlineData("/api/capabilities")]
+    [InlineData("/api/models")]
+    [InlineData("/api/account/plans")]
+    public async Task Public_endpoints_remain_available(string path)
+    {
+        var response = await _client.GetAsync(path);
+        Assert.True(response.IsSuccessStatusCode, $"{path} returned {(int)response.StatusCode}");
+    }
+
+    [Fact]
+    public async Task Stateless_inference_remains_available()
+    {
+        var response = await _client.PostAsJsonAsync("/api/chat", new { query = "What is a sill plate?" });
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+    }
+
+    // ---------- Endpoints that must be refused ----------
+
+    [Fact]
+    public async Task Anonymous_caller_cannot_read_an_account()
+    {
+        var response = await _client.GetAsync("/api/account/victim@example.com");
+        Assert.Equal(HttpStatusCode.Forbidden, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Anonymous_caller_cannot_grant_themselves_a_paid_plan()
+    {
+        var response = await _client.PostAsJsonAsync("/api/account/victim@example.com/upgrade", new { plan = "pro-plus" });
+        Assert.Equal(HttpStatusCode.Forbidden, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task A_wrong_admin_key_does_not_grant_a_paid_plan()
+    {
+        using var request = new HttpRequestMessage(HttpMethod.Post, "/api/account/victim@example.com/upgrade")
+        {
+            Content = JsonContent.Create(new { plan = "pro-plus" })
+        };
+        request.Headers.TryAddWithoutValidation("X-Auricrux-Admin-Key", "not-the-key");
+
+        var response = await _client.SendAsync(request);
+        Assert.Equal(HttpStatusCode.Forbidden, response.StatusCode);
+    }
+
+    [Theory]
+    [InlineData("/api/memory/some-session-id")]
+    [InlineData("/api/memory/some-session-id/export")]
+    [InlineData("/api/workspace")]
+    public async Task Anonymous_caller_cannot_read_tenant_data(string path)
+    {
+        var response = await _client.GetAsync(path);
+        Assert.Equal(HttpStatusCode.Forbidden, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Anonymous_caller_cannot_append_to_a_conversation()
+    {
+        var response = await _client.PostAsJsonAsync("/api/memory/some-session-id", new
+        {
+            role = "user",
+            content = "leaked",
+            backend = "sqlite"
+        });
+        Assert.Equal(HttpStatusCode.Forbidden, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Anonymous_caller_cannot_delete_workspace_content()
+    {
+        var response = await _client.DeleteAsync("/api/workspace/some-folder");
+        Assert.Equal(HttpStatusCode.Forbidden, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Lockdown_response_explains_how_to_remediate()
+    {
+        var response = await _client.GetAsync("/api/workspace");
+        var body = await response.Content.ReadAsStringAsync();
+        Assert.Contains("Auth:Enabled", body, StringComparison.OrdinalIgnoreCase);
+    }
+
+    // ---------- The administrative path still works ----------
+
+    [Fact]
+    public async Task Administrator_with_the_shared_secret_can_manage_plans()
+    {
+        var email = $"admin-managed-{Guid.NewGuid():N}@test.local";
+
+        using var register = new HttpRequestMessage(HttpMethod.Post, "/api/account/register")
+        {
+            Content = JsonContent.Create(new { email })
+        };
+        register.Headers.TryAddWithoutValidation("X-Auricrux-Admin-Key", ProductionHostFactory.AdminKey);
+        Assert.Equal(HttpStatusCode.OK, (await _client.SendAsync(register)).StatusCode);
+
+        using var upgrade = new HttpRequestMessage(HttpMethod.Post, $"/api/account/{email}/upgrade")
+        {
+            Content = JsonContent.Create(new { plan = "pro" })
+        };
+        upgrade.Headers.TryAddWithoutValidation("X-Auricrux-Admin-Key", ProductionHostFactory.AdminKey);
+
+        var response = await _client.SendAsync(upgrade);
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        Assert.Contains("\"plan\":\"pro\"", await response.Content.ReadAsStringAsync(), StringComparison.OrdinalIgnoreCase);
+    }
+
+    // ---------- Response hardening ----------
+
+    [Fact]
+    public async Task Content_security_policy_does_not_permit_unsafe_eval()
+    {
+        var response = await _client.GetAsync("/api/health");
+        var csp = response.Headers.GetValues("Content-Security-Policy").First();
+
+        Assert.DoesNotContain("unsafe-eval", csp, StringComparison.OrdinalIgnoreCase);
+        Assert.Contains("frame-ancestors 'none'", csp, StringComparison.OrdinalIgnoreCase);
+        Assert.Contains("object-src 'none'", csp, StringComparison.OrdinalIgnoreCase);
+    }
+
+    [Fact]
+    public async Task Api_responses_are_not_cacheable()
+    {
+        var response = await _client.GetAsync("/api/health");
+        Assert.Equal("no-store", response.Headers.CacheControl?.ToString());
+    }
+}
