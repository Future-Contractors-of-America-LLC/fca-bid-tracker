+using Auricrux.Web.Security;
+using Auricrux.Web.Services;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.FileProviders;
+using Microsoft.Extensions.Hosting;
+using Xunit;
+
+namespace Auricrux.Tests;
+
+/// <summary>
+/// Storage-level proof that one tenant cannot reach another tenant's conversations or files.
+/// Before tenant partitioning, a session id or workspace path was a global key: anyone who
+/// guessed or was leaked one could read, export, or delete the data behind it.
+/// </summary>
+public sealed class TenantIsolationTests : IDisposable
+{
+    private readonly string _root = Path.Combine(Path.GetTempPath(), $"auricrux-tenant-{Guid.NewGuid():N}");
+
+    private const string TenantA = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
+    private const string TenantB = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
+
+    public TenantIsolationTests() => Directory.CreateDirectory(_root);
+
+    public void Dispose()
+    {
+        try { Directory.Delete(_root, recursive: true); } catch { /* best effort */ }
+    }
+
+    [Theory]
+    [InlineData(MemoryBackend.Session)]
+    [InlineData(MemoryBackend.FileJsonl)]
+    [InlineData(MemoryBackend.Sqlite)]
+    public async Task Memory_written_by_one_tenant_is_invisible_to_another(MemoryBackend backend)
+    {
+        var memory = new ConversationMemoryService(Env());
+        const string sharedSessionId = "session-both-tenants-use-this-id";
+
+        await memory.AppendAsync(TenantA, sharedSessionId, backend, "user", "Sealed bid is 4.2M", default);
+
+        var ownerView = await memory.ListAsync(TenantA, sharedSessionId, backend, 50, default);
+        var attackerView = await memory.ListAsync(TenantB, sharedSessionId, backend, 50, default);
+
+        Assert.Single(ownerView);
+        Assert.Contains("4.2M", ownerView[0].Content);
+        Assert.Empty(attackerView);
+    }
+
+    [Fact]
+    public async Task Memory_reports_the_caller_facing_session_id_not_the_storage_key()
+    {
+        var memory = new ConversationMemoryService(Env());
+        const string sessionId = "quote-9911";
+
+        await memory.AppendAsync(TenantA, sessionId, MemoryBackend.Sqlite, "user", "Retainage question", default);
+        var turns = await memory.ListAsync(TenantA, sessionId, MemoryBackend.Sqlite, 50, default);
+
+        Assert.Single(turns);
+        Assert.Equal(sessionId, turns[0].SessionId);
+    }
+
+    [Fact]
+    public async Task Workspace_files_are_not_listable_downloadable_or_deletable_across_tenants()
+    {
+        var workspace = new WorkspaceStorageService(Env(), OpenSecurity());
+        const string fileName = "sealed-bid.txt";
+
+        await using (var content = new MemoryStream("CONFIDENTIAL"u8.ToArray()))
+        {
+            await workspace.SaveFileAsync(TenantA, "jobs", fileName, content, default);
+        }
+
+        var ownerListing = workspace.List(TenantA, "jobs");
+        Assert.Contains(ownerListing.Entries, e => e.Name == fileName);
+
+        var attackerListing = workspace.List(TenantB, "jobs");
+        Assert.DoesNotContain(attackerListing.Entries, e => e.Name == fileName);
+
+        Assert.Null(workspace.OpenFile(TenantB, $"jobs/{fileName}"));
+        Assert.False(workspace.Delete(TenantB, $"jobs/{fileName}"));
+
+        // The owner's copy survived the other tenant's delete attempt.
+        Assert.NotNull(workspace.OpenFile(TenantA, $"jobs/{fileName}"));
+    }
+
+    [Fact]
+    public async Task Workspace_rejects_disallowed_file_extensions()
+    {
+        var workspace = new WorkspaceStorageService(Env(), OpenSecurity());
+        await using var content = new MemoryStream("<script>alert(1)</script>"u8.ToArray());
+
+        var ex = await Assert.ThrowsAsync<InvalidOperationException>(
+            () => workspace.SaveFileAsync(TenantA, null, "payload.svg", content, default));
+        Assert.Contains("not accepted", ex.Message, StringComparison.OrdinalIgnoreCase);
+    }
+
+    [Fact]
+    public async Task Workspace_enforces_the_upload_size_limit_while_copying()
+    {
+        var workspace = new WorkspaceStorageService(Env(), OpenSecurity(maxUploadBytes: 1_024));
+        await using var content = new MemoryStream(new byte[4_096]);
+
+        await Assert.ThrowsAsync<InvalidOperationException>(
+            () => workspace.SaveFileAsync(TenantA, null, "big.txt", content, default));
+
+        // The rejected upload must not be left behind as a partial file.
+        Assert.DoesNotContain(workspace.List(TenantA).Entries, e => e.Name == "big.txt");
+    }
+
+    [Theory]
+    [InlineData("../../../etc/passwd")]
+    [InlineData("..\\..\\windows\\win.ini")]
+    [InlineData("jobs/../../escape.txt")]
+    public void Workspace_rejects_path_traversal(string path)
+    {
+        var workspace = new WorkspaceStorageService(Env(), OpenSecurity());
+        Assert.Throws<InvalidOperationException>(() => workspace.CreateFolder(TenantA, path));
+    }
+
+    [Fact]
+    public void Tenant_keys_are_stable_opaque_and_distinct_per_subject()
+    {
+        var first = CallerContextResolver.TenantKeyFor("user@example.com");
+        var repeat = CallerContextResolver.TenantKeyFor("USER@example.com ");
+        var other = CallerContextResolver.TenantKeyFor("someone-else@example.com");
+
+        Assert.Equal(first, repeat);
+        Assert.NotEqual(first, other);
+        Assert.Equal(32, first.Length);
+        Assert.DoesNotContain("@", first, StringComparison.Ordinal);
+    }
+
+    private IWebHostEnvironment Env() => new TestWebHostEnvironment(_root);
+
+    private static AuricruxSecurityOptions OpenSecurity(long maxUploadBytes = 26_214_400L)
+        => AuricruxSecurityOptions.Resolve(
+            new ConfigurationBuilder()
+                .AddInMemoryCollection(new Dictionary<string, string?>
+                {
+                    ["Security:MaxUploadBytes"] = maxUploadBytes.ToString()
+                })
+                .Build(),
+            new TestWebHostEnvironment(Path.GetTempPath()));
+
+    private sealed class TestWebHostEnvironment(string contentRoot) : IWebHostEnvironment
+    {
+        public string ApplicationName { get; set; } = "Auricrux.Tests";
+        public IFileProvider ContentRootFileProvider { get; set; } = new PhysicalFileProvider(contentRoot);
+        public string ContentRootPath { get; set; } = contentRoot;
+        public string EnvironmentName { get; set; } = Environments.Development;
+        public IFileProvider WebRootFileProvider { get; set; } = new PhysicalFileProvider(contentRoot);
+        public string WebRootPath { get; set; } = contentRoot;
+    }
+}
