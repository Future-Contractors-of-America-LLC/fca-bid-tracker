+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Xunit;
+
+namespace Auricrux.Tests;
+
+/// <summary>
+/// Incremental chat delivery. Peer assistants render tokens as they are produced; Auricrux
+/// previously returned only a finished response, so a long answer showed nothing until complete.
+/// These tests assert the Server-Sent Events contract holds even when no local model is reachable
+/// and the corpus fallback supplies the text.
+/// </summary>
+public sealed class StreamingChatTests(WebApplicationFactory<Program> factory)
+    : IClassFixture<WebApplicationFactory<Program>>
+{
+    private readonly HttpClient _client = factory.CreateClient();
+
+    [Fact]
+    public async Task Stream_is_served_as_server_sent_events()
+    {
+        using var response = await PostStreamAsync(new { query = "What is a sill plate?" });
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        Assert.Equal("text/event-stream", response.Content.Headers.ContentType?.MediaType);
+        Assert.Equal("no-store", response.Headers.CacheControl?.ToString());
+    }
+
+    [Fact]
+    public async Task Stream_emits_sources_then_tokens_then_done()
+    {
+        var events = await ReadEventsAsync(new { query = "What is a sill plate?" });
+
+        Assert.Equal("sources", events[0].Name);
+        Assert.Equal("done", events[^1].Name);
+        Assert.Contains(events, e => e.Name == "token");
+
+        // Citations arrive before any generated text so the client can render them immediately.
+        var firstToken = events.FindIndex(e => e.Name == "token");
+        Assert.True(firstToken > 0);
+    }
+
+    [Fact]
+    public async Task Stream_reassembles_into_non_empty_answer_text()
+    {
+        var events = await ReadEventsAsync(new { query = "Explain retainage on a pay application." });
+
+        var text = string.Concat(events
+            .Where(e => e.Name == "token")
+            .Select(e => e.Data.GetProperty("text").GetString()));
+
+        Assert.False(string.IsNullOrWhiteSpace(text));
+    }
+
+    [Fact]
+    public async Task Done_event_carries_the_interaction_id_that_feedback_accepts()
+    {
+        var events = await ReadEventsAsync(new { query = "OSHA fall protection trigger height" });
+        var done = events.Single(e => e.Name == "done");
+        var interactionId = done.Data.GetProperty("interactionId").GetString();
+
+        Assert.False(string.IsNullOrWhiteSpace(interactionId));
+
+        var feedback = await _client.PostAsJsonAsync($"/api/feedback/{interactionId}", new { stars = 5 });
+        Assert.Equal(HttpStatusCode.Accepted, feedback.StatusCode);
+    }
+
+    [Fact]
+    public async Task Stream_reports_a_missing_query_as_an_error_event()
+    {
+        var events = await ReadEventsAsync(new { query = "   " });
+
+        Assert.Single(events);
+        Assert.Equal("error", events[0].Name);
+    }
+
+    [Fact]
+    public async Task Stream_rejects_an_oversized_prompt()
+    {
+        var events = await ReadEventsAsync(new { query = new string('x', 40_000) });
+
+        Assert.Equal("error", events[0].Name);
+        Assert.Contains("limit", events[0].Data.GetProperty("error").GetString()!, StringComparison.OrdinalIgnoreCase);
+    }
+
+    // ---------- Enum wire-format compatibility ----------
+
+    [Theory]
+    [InlineData("Auto", "Both")]    // the contract documented in README.md
+    [InlineData("auto", "both")]    // what AuricruxApiClient actually serializes
+    [InlineData("Deep", "Internal")]
+    public async Task Chat_accepts_enum_values_as_json_strings(string mode, string scope)
+    {
+        var response = await _client.PostAsJsonAsync("/api/chat", new
+        {
+            query = "What is a sill plate?",
+            thinkingMode = mode,
+            searchScope = scope
+        });
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Chat_still_accepts_enum_values_as_numbers()
+    {
+        var response = await _client.PostAsJsonAsync("/api/chat", new
+        {
+            query = "What is a sill plate?",
+            thinkingMode = 1,
+            searchScope = 2
+        });
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Chat_rejects_an_oversized_prompt()
+    {
+        var response = await _client.PostAsJsonAsync("/api/chat", new { query = new string('x', 40_000) });
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+    }
+
+    private async Task<HttpResponseMessage> PostStreamAsync(object body)
+    {
+        using var request = new HttpRequestMessage(HttpMethod.Post, "/api/chat/stream")
+        {
+            Content = JsonContent.Create(body)
+        };
+        return await _client.SendAsync(request, HttpCompletionOption.ResponseHeadersRead);
+    }
+
+    private async Task<List<SseEvent>> ReadEventsAsync(object body)
+    {
+        using var response = await PostStreamAsync(body);
+        await using var stream = await response.Content.ReadAsStreamAsync();
+        using var reader = new StreamReader(stream);
+
+        var events = new List<SseEvent>();
+        string? name = null;
+        while (await reader.ReadLineAsync() is { } line)
+        {
+            if (line.StartsWith("event: ", StringComparison.Ordinal))
+            {
+                name = line["event: ".Length..];
+            }
+            else if (line.StartsWith("data: ", StringComparison.Ordinal) && name is not null)
+            {
+                using var doc = JsonDocument.Parse(line["data: ".Length..]);
+                events.Add(new SseEvent(name, doc.RootElement.Clone()));
+                name = null;
+            }
+        }
+
+        return events;
+    }
+
+    private sealed record SseEvent(string Name, JsonElement Data);
+}
