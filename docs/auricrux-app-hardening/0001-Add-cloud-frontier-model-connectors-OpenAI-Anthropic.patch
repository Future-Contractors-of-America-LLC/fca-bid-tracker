+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Auricrux.Shared.Models;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Xunit;
+
+namespace Auricrux.Tests;
+
+/// <summary>
+/// Streaming chat parity (SSE): /api/chat/stream must emit data: events ending in a
+/// terminal done event carrying the full response metadata. Works with or without a live
+/// Ollama — when the model is unreachable the corpus fallback still streams as content.
+/// </summary>
+public sealed class StreamingChatTests : IClassFixture<WebApplicationFactory<Program>>
+{
+    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
+    private readonly HttpClient _client;
+
+    public StreamingChatTests(WebApplicationFactory<Program> factory)
+    {
+        _client = factory.CreateClient();
+    }
+
+    [Fact]
+    public async Task Chat_stream_emits_sse_deltas_and_terminal_done_event()
+    {
+        using var request = new HttpRequestMessage(HttpMethod.Post, "/api/chat/stream")
+        {
+            Content = JsonContent.Create(new ChatRequest { Query = "What triggers fall protection on a roof?" })
+        };
+
+        using var response = await _client.SendAsync(request, HttpCompletionOption.ResponseHeadersRead);
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        Assert.Equal("text/event-stream", response.Content.Headers.ContentType?.MediaType);
+
+        var events = await ReadEventsAsync(response);
+        Assert.NotEmpty(events);
+
+        var terminal = events.Last();
+        Assert.True(terminal.Done, "Last SSE event must have done=true.");
+        Assert.NotNull(terminal.Response);
+        Assert.False(string.IsNullOrWhiteSpace(terminal.Response!.Content));
+        Assert.NotNull(terminal.Response.InteractionId);
+
+        var streamedContent = string.Concat(events.Where(e => !e.Done).Select(e => e.Delta));
+        Assert.Equal(streamedContent, terminal.Response.Content);
+    }
+
+    [Fact]
+    public async Task Chat_stream_rejects_empty_query()
+    {
+        var response = await _client.PostAsJsonAsync("/api/chat/stream", new { query = "" });
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Chat_stream_enforces_freemium_model_gating()
+    {
+        var email = $"stream-gate-{Guid.NewGuid():N}@test.local";
+        await _client.PostAsJsonAsync("/api/account/register", new { email });
+
+        using var request = new HttpRequestMessage(HttpMethod.Post, "/api/chat/stream?model=mistral")
+        {
+            Content = JsonContent.Create(new ChatRequest { Query = "What is a sill plate?" })
+        };
+        request.Headers.TryAddWithoutValidation("X-Auricrux-Email", email);
+
+        var response = await _client.SendAsync(request);
+        Assert.Equal(HttpStatusCode.Forbidden, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Chat_stream_interaction_accepts_feedback()
+    {
+        using var request = new HttpRequestMessage(HttpMethod.Post, "/api/chat/stream")
+        {
+            Content = JsonContent.Create(new ChatRequest { Query = "How long should concrete cure before stripping forms?" })
+        };
+        using var response = await _client.SendAsync(request, HttpCompletionOption.ResponseHeadersRead);
+        var events = await ReadEventsAsync(response);
+        var interactionId = events.Last().Response!.InteractionId!.Value;
+
+        var feedback = await _client.PostAsJsonAsync($"/api/feedback/{interactionId}", new { stars = 5, comment = "streamed" });
+        Assert.Equal(HttpStatusCode.Accepted, feedback.StatusCode);
+    }
+
+    private static async Task<List<ChatStreamEvent>> ReadEventsAsync(HttpResponseMessage response)
+    {
+        var events = new List<ChatStreamEvent>();
+        await using var stream = await response.Content.ReadAsStreamAsync();
+        using var reader = new StreamReader(stream);
+        while (await reader.ReadLineAsync() is { } line)
+        {
+            if (!line.StartsWith("data:", StringComparison.Ordinal))
+            {
+                continue;
+            }
+
+            var data = line[5..].Trim();
+            if (data.Length == 0)
+            {
+                continue;
+            }
+
+            var evt = JsonSerializer.Deserialize<ChatStreamEvent>(data, JsonOptions);
+            if (evt is not null)
+            {
+                events.Add(evt);
+            }
+        }
+
+        return events;
+    }
+}
