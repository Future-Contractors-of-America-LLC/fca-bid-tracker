+using System.Runtime.CompilerServices;
+using System.Text;
+using System.Text.Json;
+
+namespace Auricrux.Web.Services;
+
+/// <summary>
+/// Optional cloud frontier-model connectors (OpenAI, Anthropic/Claude, Google Gemini,
+/// xAI/Grok, Azure OpenAI) alongside the default local Ollama runtime.
+///
+/// Providers are enabled purely by configuration/environment — no key is ever stored in the
+/// repo. Keys resolve from <c>Auricrux:Providers:{Name}:ApiKey</c> or the conventional
+/// environment variables (OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY / GOOGLE_API_KEY,
+/// XAI_API_KEY, AZURE_OPENAI_API_KEY). Cloud models are addressed with a provider prefix,
+/// e.g. <c>openai:gpt-4o-mini</c>, <c>anthropic:claude-sonnet-4-5</c>,
+/// <c>gemini:gemini-2.0-flash</c>, <c>xai:grok-3</c>, <c>azure:my-deployment</c>.
+/// Unprefixed model names continue to route to Ollama unchanged.
+/// </summary>
+public sealed class CloudModelGateway(
+    IHttpClientFactory httpClientFactory,
+    IConfiguration config,
+    ILogger<CloudModelGateway> logger)
+{
+    private static readonly (string Prefix, string ConfigName, string[] EnvKeys, string DefaultBaseUrl, string[] DefaultModels)[] ProviderTable =
+    [
+        ("openai", "OpenAI", ["OPENAI_API_KEY"], "https://api.openai.com/v1", ["gpt-4o-mini", "gpt-4o"]),
+        ("anthropic", "Anthropic", ["ANTHROPIC_API_KEY"], "https://api.anthropic.com/v1", ["claude-sonnet-4-5", "claude-haiku-4-5"]),
+        ("gemini", "Gemini", ["GEMINI_API_KEY", "GOOGLE_API_KEY"], "https://generativelanguage.googleapis.com/v1beta", ["gemini-2.0-flash", "gemini-2.5-pro"]),
+        ("xai", "XAI", ["XAI_API_KEY"], "https://api.x.ai/v1", ["grok-3", "grok-3-mini"]),
+        ("azure", "AzureOpenAI", ["AZURE_OPENAI_API_KEY"], "", [])
+    ];
+
+    /// <summary>Cloud models currently usable (providers with a resolvable API key), prefixed per provider.</summary>
+    public IReadOnlyList<string> ListModels()
+    {
+        var models = new List<string>();
+        foreach (var provider in ProviderTable)
+        {
+            if (ResolveKey(provider.ConfigName, provider.EnvKeys) is null)
+            {
+                continue;
+            }
+
+            var configured = config.GetSection($"Auricrux:Providers:{provider.ConfigName}:Models").Get<string[]>();
+            var names = configured is { Length: > 0 } ? configured : provider.DefaultModels;
+            models.AddRange(names.Select(m => $"{provider.Prefix}:{m}"));
+        }
+
+        return models;
+    }
+
+    /// <summary>True when the model name targets a configured cloud provider.</summary>
+    public bool TryResolve(string? model, out CloudModelRoute route)
+    {
+        route = default;
+        if (string.IsNullOrWhiteSpace(model))
+        {
+            return false;
+        }
+
+        var separator = model.IndexOf(':');
+        if (separator <= 0)
+        {
+            return false;
+        }
+
+        var prefix = model[..separator].Trim().ToLowerInvariant();
+        var name = model[(separator + 1)..].Trim();
+        var provider = ProviderTable.FirstOrDefault(p => p.Prefix == prefix);
+        if (provider.Prefix is null || string.IsNullOrWhiteSpace(name))
+        {
+            return false;
+        }
+
+        var key = ResolveKey(provider.ConfigName, provider.EnvKeys);
+        if (key is null)
+        {
+            return false;
+        }
+
+        var baseUrl = config[$"Auricrux:Providers:{provider.ConfigName}:BaseUrl"];
+        if (string.IsNullOrWhiteSpace(baseUrl))
+        {
+            baseUrl = provider.Prefix == "azure"
+                ? Environment.GetEnvironmentVariable("AZURE_OPENAI_ENDPOINT")
+                : provider.DefaultBaseUrl;
+        }
+
+        if (string.IsNullOrWhiteSpace(baseUrl))
+        {
+            logger.LogWarning("Cloud provider {Provider} has a key but no BaseUrl/endpoint configured", provider.ConfigName);
+            return false;
+        }
+
+        route = new CloudModelRoute(provider.Prefix, provider.ConfigName, name, baseUrl.TrimEnd('/'), key);
+        return true;
+    }
+
+    /// <summary>Non-streaming completion via the resolved cloud provider.</summary>
+    public async Task<string> CompleteAsync(
+        CloudModelRoute route,
+        string system,
+        IReadOnlyList<(string Role, string Content)> messages,
+        CancellationToken ct)
+    {
+        var buffer = new StringBuilder();
+        await foreach (var delta in StreamAsync(route, system, messages, stream: false, ct))
+        {
+            buffer.Append(delta);
+        }
+
+        return buffer.ToString();
+    }
+
+    /// <summary>Streaming completion (SSE) via the resolved cloud provider.</summary>
+    public IAsyncEnumerable<string> StreamAsync(
+        CloudModelRoute route,
+        string system,
+        IReadOnlyList<(string Role, string Content)> messages,
+        CancellationToken ct)
+        => StreamAsync(route, system, messages, stream: true, ct);
+
+    private async IAsyncEnumerable<string> StreamAsync(
+        CloudModelRoute route,
+        string system,
+        IReadOnlyList<(string Role, string Content)> messages,
+        bool stream,
+        [EnumeratorCancellation] CancellationToken ct)
+    {
+        using var request = route.Provider switch
+        {
+            "anthropic" => BuildAnthropicRequest(route, system, messages, stream),
+            "gemini" => BuildGeminiRequest(route, system, messages, stream),
+            _ => BuildOpenAiCompatibleRequest(route, system, messages, stream)
+        };
+
+        var http = httpClientFactory.CreateClient(nameof(CloudModelGateway));
+        using var response = await http.SendAsync(request, HttpCompletionOption.ResponseHeadersRead, ct);
+        if (!response.IsSuccessStatusCode)
+        {
+            var body = await response.Content.ReadAsStringAsync(ct);
+            logger.LogWarning("Cloud provider {Provider} model {Model} returned {Status}: {Body}",
+                route.ProviderName, route.Model, (int)response.StatusCode, Truncate(body, 400));
+            throw new CloudModelException(
+                $"{route.ProviderName} returned {(int)response.StatusCode} for model '{route.Model}'.");
+        }
+
+        if (!stream)
+        {
+            var payload = await response.Content.ReadAsStringAsync(ct);
+            yield return ParseNonStreamingContent(route.Provider, payload);
+            yield break;
+        }
+
+        await using var bodyStream = await response.Content.ReadAsStreamAsync(ct);
+        using var reader = new StreamReader(bodyStream);
+        while (await reader.ReadLineAsync(ct) is { } line)
+        {
+            if (!line.StartsWith("data:", StringComparison.Ordinal))
+            {
+                continue;
+            }
+
+            var data = line[5..].Trim();
+            if (data.Length == 0 || data == "[DONE]")
+            {
+                continue;
+            }
+
+            var delta = ParseStreamDelta(route.Provider, data);
+            if (!string.IsNullOrEmpty(delta))
+            {
+                yield return delta;
+            }
+        }
+    }
+
+    private static HttpRequestMessage BuildOpenAiCompatibleRequest(
+        CloudModelRoute route,
+        string system,
+        IReadOnlyList<(string Role, string Content)> messages,
+        bool stream)
+    {
+        var payload = new
+        {
+            model = route.Model,
+            stream,
+            messages = BuildOpenAiMessages(system, messages)
+        };
+
+        var request = new HttpRequestMessage(HttpMethod.Post, $"{route.BaseUrl}/chat/completions")
+        {
+            Content = JsonBody(payload)
+        };
+
+        if (route.Provider == "azure")
+        {
+            // Azure OpenAI accepts the key via the api-key header on its OpenAI-compatible v1 surface.
+            request.Headers.TryAddWithoutValidation("api-key", route.ApiKey);
+        }
+        else
+        {
+            request.Headers.TryAddWithoutValidation("Authorization", $"Bearer {route.ApiKey}");
+        }
+
+        return request;
+    }
+
+    private static HttpRequestMessage BuildAnthropicRequest(
+        CloudModelRoute route,
+        string system,
+        IReadOnlyList<(string Role, string Content)> messages,
+        bool stream)
+    {
+        var payload = new
+        {
+            model = route.Model,
+            max_tokens = 4096,
+            stream,
+            system,
+            messages = messages
+                .Where(m => m.Role is "user" or "assistant")
+                .Select(m => new { role = m.Role, content = m.Content })
+                .ToArray()
+        };
+
+        var request = new HttpRequestMessage(HttpMethod.Post, $"{route.BaseUrl}/messages")
+        {
+            Content = JsonBody(payload)
+        };
+        request.Headers.TryAddWithoutValidation("x-api-key", route.ApiKey);
+        request.Headers.TryAddWithoutValidation("anthropic-version", "2023-06-01");
+        return request;
+    }
+
+    private static HttpRequestMessage BuildGeminiRequest(
+        CloudModelRoute route,
+        string system,
+        IReadOnlyList<(string Role, string Content)> messages,
+        bool stream)
+    {
+        var payload = new
+        {
+            system_instruction = new { parts = new[] { new { text = system } } },
+            contents = messages
+                .Where(m => m.Role is "user" or "assistant")
+                .Select(m => new
+                {
+                    role = m.Role == "assistant" ? "model" : "user",
+                    parts = new[] { new { text = m.Content } }
+                })
+                .ToArray()
+        };
+
+        var verb = stream ? "streamGenerateContent?alt=sse" : "generateContent";
+        var request = new HttpRequestMessage(
+            HttpMethod.Post,
+            $"{route.BaseUrl}/models/{Uri.EscapeDataString(route.Model)}:{verb}")
+        {
+            Content = JsonBody(payload)
+        };
+        request.Headers.TryAddWithoutValidation("x-goog-api-key", route.ApiKey);
+        return request;
+    }
+
+    private static object[] BuildOpenAiMessages(string system, IReadOnlyList<(string Role, string Content)> messages)
+    {
+        var list = new List<object> { new { role = "system", content = system } };
+        list.AddRange(messages
+            .Where(m => m.Role is "user" or "assistant")
+            .Select(m => (object)new { role = m.Role, content = m.Content }));
+        return [.. list];
+    }
+
+    private static string ParseNonStreamingContent(string provider, string payload)
+    {
+        using var doc = JsonDocument.Parse(payload);
+        var root = doc.RootElement;
+        return provider switch
+        {
+            "anthropic" => root.TryGetProperty("content", out var content) && content.ValueKind == JsonValueKind.Array
+                ? string.Concat(content.EnumerateArray()
+                    .Where(b => b.TryGetProperty("type", out var t) && t.GetString() == "text")
+                    .Select(b => b.GetProperty("text").GetString()))
+                : string.Empty,
+            "gemini" => root.TryGetProperty("candidates", out var candidates)
+                        && candidates.ValueKind == JsonValueKind.Array
+                        && candidates.GetArrayLength() > 0
+                ? string.Concat(candidates[0].GetProperty("content").GetProperty("parts").EnumerateArray()
+                    .Select(p => p.TryGetProperty("text", out var t) ? t.GetString() : null))
+                : string.Empty,
+            _ => root.TryGetProperty("choices", out var choices)
+                 && choices.ValueKind == JsonValueKind.Array
+                 && choices.GetArrayLength() > 0
+                 && choices[0].GetProperty("message").TryGetProperty("content", out var msg)
+                ? msg.GetString() ?? string.Empty
+                : string.Empty
+        };
+    }
+
+    private static string? ParseStreamDelta(string provider, string data)
+    {
+        using var doc = JsonDocument.Parse(data);
+        var root = doc.RootElement;
+        switch (provider)
+        {
+            case "anthropic":
+                if (root.TryGetProperty("type", out var type)
+                    && type.GetString() == "content_block_delta"
+                    && root.TryGetProperty("delta", out var anthDelta)
+                    && anthDelta.TryGetProperty("text", out var anthText))
+                {
+                    return anthText.GetString();
+                }
+
+                return null;
+
+            case "gemini":
+                if (root.TryGetProperty("candidates", out var candidates)
+                    && candidates.ValueKind == JsonValueKind.Array
+                    && candidates.GetArrayLength() > 0
+                    && candidates[0].TryGetProperty("content", out var content)
+                    && content.TryGetProperty("parts", out var parts)
+                    && parts.ValueKind == JsonValueKind.Array)
+                {
+                    return string.Concat(parts.EnumerateArray()
+                        .Select(p => p.TryGetProperty("text", out var t) ? t.GetString() : null));
+                }
+
+                return null;
+
+            default:
+                if (root.TryGetProperty("choices", out var choices)
+                    && choices.ValueKind == JsonValueKind.Array
+                    && choices.GetArrayLength() > 0
+                    && choices[0].TryGetProperty("delta", out var delta)
+                    && delta.TryGetProperty("content", out var text))
+                {
+                    return text.GetString();
+                }
+
+                return null;
+        }
+    }
+
+    private string? ResolveKey(string configName, string[] envKeys)
+    {
+        var configured = config[$"Auricrux:Providers:{configName}:ApiKey"];
+        if (!string.IsNullOrWhiteSpace(configured))
+        {
+            return configured.Trim();
+        }
+
+        foreach (var env in envKeys)
+        {
+            var value = Environment.GetEnvironmentVariable(env);
+            if (!string.IsNullOrWhiteSpace(value))
+            {
+                return value.Trim();
+            }
+        }
+
+        return null;
+    }
+
+    private static StringContent JsonBody(object payload)
+        => new(JsonSerializer.Serialize(payload), Encoding.UTF8, "application/json");
+
+    private static string Truncate(string value, int max)
+        => value.Length <= max ? value : value[..max];
+}
+
+/// <summary>Resolved routing target for a provider-prefixed cloud model name.</summary>
+public readonly record struct CloudModelRoute(
+    string Provider,
+    string ProviderName,
+    string Model,
+    string BaseUrl,
+    string ApiKey);
+
+/// <summary>Raised when a cloud provider rejects a request; callers fall back to corpus mode.</summary>
+public sealed class CloudModelException(string message) : Exception(message);
