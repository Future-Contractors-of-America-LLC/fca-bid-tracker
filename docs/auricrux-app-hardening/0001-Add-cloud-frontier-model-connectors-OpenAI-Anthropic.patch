+using System.Net;
+using System.Net.Http.Json;
+using Auricrux.Web.Services;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.Extensions.Configuration;
+using Microsoft.Extensions.Logging.Abstractions;
+using Xunit;
+
+namespace Auricrux.Tests;
+
+/// <summary>
+/// Cloud frontier-model connectors: providers stay dark until an API key is configured,
+/// provider-prefixed model names resolve to the right endpoint, and /api/models surfaces
+/// configured cloud models next to the local Ollama models. No network calls are made —
+/// these tests cover routing/config only, never live provider traffic.
+/// </summary>
+public sealed class CloudModelGatewayTests
+{
+    [Fact]
+    public void No_configured_keys_means_no_cloud_models_and_no_routing()
+    {
+        var gateway = CreateGateway(new Dictionary<string, string?>());
+
+        Assert.Empty(gateway.ListModels());
+        Assert.False(gateway.TryResolve("openai:gpt-4o-mini", out _));
+        Assert.False(gateway.TryResolve("anthropic:claude-sonnet-4-5", out _));
+    }
+
+    [Fact]
+    public void Unprefixed_model_names_never_route_to_cloud()
+    {
+        var gateway = CreateGateway(new Dictionary<string, string?>
+        {
+            ["Auricrux:Providers:OpenAI:ApiKey"] = "sk-test"
+        });
+
+        Assert.False(gateway.TryResolve("llama3.2", out _));
+        Assert.False(gateway.TryResolve("auricrux-fca", out _));
+        Assert.False(gateway.TryResolve(null, out _));
+    }
+
+    [Fact]
+    public void Configured_openai_key_lists_models_and_resolves_route()
+    {
+        var gateway = CreateGateway(new Dictionary<string, string?>
+        {
+            ["Auricrux:Providers:OpenAI:ApiKey"] = "sk-test"
+        });
+
+        Assert.Contains("openai:gpt-4o-mini", gateway.ListModels());
+        Assert.True(gateway.TryResolve("openai:gpt-4o-mini", out var route));
+        Assert.Equal("openai", route.Provider);
+        Assert.Equal("gpt-4o-mini", route.Model);
+        Assert.Equal("https://api.openai.com/v1", route.BaseUrl);
+        Assert.Equal("sk-test", route.ApiKey);
+    }
+
+    [Fact]
+    public void All_five_providers_resolve_with_keys_configured()
+    {
+        var gateway = CreateGateway(new Dictionary<string, string?>
+        {
+            ["Auricrux:Providers:OpenAI:ApiKey"] = "sk-openai",
+            ["Auricrux:Providers:Anthropic:ApiKey"] = "sk-anthropic",
+            ["Auricrux:Providers:Gemini:ApiKey"] = "sk-gemini",
+            ["Auricrux:Providers:XAI:ApiKey"] = "sk-xai",
+            ["Auricrux:Providers:AzureOpenAI:ApiKey"] = "sk-azure",
+            ["Auricrux:Providers:AzureOpenAI:BaseUrl"] = "https://myresource.openai.azure.com/openai/v1"
+        });
+
+        Assert.True(gateway.TryResolve("openai:gpt-4o", out _));
+        Assert.True(gateway.TryResolve("anthropic:claude-sonnet-4-5", out var anthropic));
+        Assert.Equal("https://api.anthropic.com/v1", anthropic.BaseUrl);
+        Assert.True(gateway.TryResolve("gemini:gemini-2.0-flash", out var gemini));
+        Assert.Equal("https://generativelanguage.googleapis.com/v1beta", gemini.BaseUrl);
+        Assert.True(gateway.TryResolve("xai:grok-3", out var xai));
+        Assert.Equal("https://api.x.ai/v1", xai.BaseUrl);
+        Assert.True(gateway.TryResolve("azure:my-deployment", out var azure));
+        Assert.Equal("https://myresource.openai.azure.com/openai/v1", azure.BaseUrl);
+    }
+
+    [Fact]
+    public void Azure_without_endpoint_stays_dark_even_with_key()
+    {
+        var gateway = CreateGateway(new Dictionary<string, string?>
+        {
+            ["Auricrux:Providers:AzureOpenAI:ApiKey"] = "sk-azure"
+        });
+
+        Assert.False(gateway.TryResolve("azure:my-deployment", out _));
+    }
+
+    [Fact]
+    public void Custom_model_list_overrides_defaults()
+    {
+        var gateway = CreateGateway(new Dictionary<string, string?>
+        {
+            ["Auricrux:Providers:Anthropic:ApiKey"] = "sk-test",
+            ["Auricrux:Providers:Anthropic:Models:0"] = "claude-opus-4-6"
+        });
+
+        var models = gateway.ListModels();
+        Assert.Contains("anthropic:claude-opus-4-6", models);
+        Assert.DoesNotContain("anthropic:claude-sonnet-4-5", models);
+    }
+
+    [Fact]
+    public async Task Models_endpoint_surfaces_configured_cloud_models()
+    {
+        using var factory = new WebApplicationFactory<Program>().WithWebHostBuilder(builder =>
+            builder.ConfigureAppConfiguration((_, config) =>
+                config.AddInMemoryCollection(new Dictionary<string, string?>
+                {
+                    ["Auricrux:Providers:OpenAI:ApiKey"] = "sk-test"
+                })));
+        using var client = factory.CreateClient();
+
+        var response = await client.GetAsync("/api/models");
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var payload = await response.Content.ReadFromJsonAsync<ModelsPayload>();
+        Assert.NotNull(payload);
+        Assert.Contains("openai:gpt-4o-mini", payload!.Models);
+        Assert.Contains(payload.Models, m => !m.Contains(':'));
+    }
+
+    private static CloudModelGateway CreateGateway(Dictionary<string, string?> settings)
+    {
+        var config = new ConfigurationBuilder().AddInMemoryCollection(settings).Build();
+        return new CloudModelGateway(new StubHttpClientFactory(), config, NullLogger<CloudModelGateway>.Instance);
+    }
+
+    private sealed class StubHttpClientFactory : IHttpClientFactory
+    {
+        public HttpClient CreateClient(string name) => new();
+    }
+
+    private sealed class ModelsPayload
+    {
+        public List<string> Models { get; set; } = [];
+    }
+}
