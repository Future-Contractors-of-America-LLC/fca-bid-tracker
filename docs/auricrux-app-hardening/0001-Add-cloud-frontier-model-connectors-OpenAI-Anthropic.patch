+    /// <summary>
+    /// Send a chat query to the streaming endpoint (/api/chat/stream) and yield events
+    /// as they arrive: content deltas first, then a terminal event (Done=true) with the
+    /// full ChatResponse metadata. Transport errors yield a single Error event so callers
+    /// can fall back to the non-streaming path.
+    /// </summary>
+    public async IAsyncEnumerable<ChatStreamEvent> SendChatStreamAsync(
+        ChatRequest request,
+        string? model = null,
+        string? accountEmail = null,
+        [System.Runtime.CompilerServices.EnumeratorCancellation] CancellationToken cancellationToken = default)
+    {
+        var options = CreateJsonOptions();
+        var path = string.IsNullOrWhiteSpace(model)
+            ? "api/chat/stream"
+            : $"api/chat/stream?model={Uri.EscapeDataString(model.Trim())}";
+
+        HttpResponseMessage? response = null;
+        string? transportError = null;
+        try
+        {
+            using var httpRequest = new HttpRequestMessage(HttpMethod.Post, path)
+            {
+                Content = JsonContent.Create(request, options: options)
+            };
+            if (!string.IsNullOrWhiteSpace(accountEmail))
+            {
+                httpRequest.Headers.TryAddWithoutValidation("X-Auricrux-Email", accountEmail.Trim());
+            }
+
+            response = await _httpClient.SendAsync(httpRequest, HttpCompletionOption.ResponseHeadersRead, cancellationToken);
+            if (!response.IsSuccessStatusCode)
+            {
+                var body = await response.Content.ReadAsStringAsync(cancellationToken);
+                _logger.LogError($"Streaming API error: {response.StatusCode} - {body}");
+                transportError = $"API error {(int)response.StatusCode}";
+                response.Dispose();
+                response = null;
+            }
+        }
+        catch (Exception ex)
+        {
+            _logger.LogError($"Streaming request failed: {ex.Message}");
+            transportError = ex.Message;
+            response?.Dispose();
+            response = null;
+        }
+
+        if (response is null)
+        {
+            yield return new ChatStreamEvent { Done = true, Error = transportError ?? "Streaming request failed." };
+            yield break;
+        }
+
+        using (response)
+        {
+            await using var stream = await response.Content.ReadAsStreamAsync(cancellationToken);
+            using var reader = new StreamReader(stream);
+            while (true)
+            {
+                ChatStreamEvent? evt = null;
+                string? readError = null;
+                var endOfStream = false;
+                try
+                {
+                    var line = await reader.ReadLineAsync(cancellationToken);
+                    if (line is null)
+                    {
+                        endOfStream = true;
+                    }
+                    else if (line.StartsWith("data:", StringComparison.Ordinal))
+                    {
+                        var data = line[5..].Trim();
+                        if (data.Length > 0)
+                        {
+                            evt = JsonSerializer.Deserialize<ChatStreamEvent>(data, options);
+                        }
+                    }
+                }
+                catch (Exception ex)
+                {
+                    _logger.LogError($"Streaming read failed: {ex.Message}");
+                    readError = ex.Message;
+                }
+
+                if (readError is not null)
+                {
+                    yield return new ChatStreamEvent { Done = true, Error = readError };
+                    yield break;
+                }
+
+                if (endOfStream)
+                {
+                    break;
+                }
+
+                if (evt is null)
+                {
+                    continue;
+                }
+
+                yield return evt;
+                if (evt.Done)
+                {
+                    yield break;
+                }
+            }
+        }
+    }
+
