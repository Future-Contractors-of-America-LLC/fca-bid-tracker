+/// <summary>
+/// One server-sent event from the streaming chat endpoint (/api/chat/stream).
+/// Delta events carry incremental content; the terminal event has Done=true and the
+/// complete ChatResponse (sources, interaction id, timing).
+/// </summary>
+public class ChatStreamEvent
+{
+    /// <summary>Incremental content chunk (null on the terminal event)</summary>
+    public string? Delta { get; set; }
+
+    /// <summary>True on the terminal event of the stream</summary>
+    public bool Done { get; set; }
+
+    /// <summary>Full response metadata, present when Done=true</summary>
+    public ChatResponse? Response { get; set; }
+
+    /// <summary>Error description when the stream failed</summary>
+    public string? Error { get; set; }
+}
